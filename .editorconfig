# Padrão de formatação do projeto (lido pelo Rider, Visual Studio e VS Code)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,csproj,props,targets,xml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sln]
end_of_line = crlf
charset = utf-8-bom
indent_style = tab

[*.cs]
# Organização dos usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Preferências de estilo (sugestões, não erros)
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

# Nomes: interfaces com I, campos privados em camelCase
dotnet_naming_rule.interfaces_com_i.severity = suggestion
dotnet_naming_rule.interfaces_com_i.symbols = interfaces
dotnet_naming_rule.interfaces_com_i.style = prefixo_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefixo_i.required_prefix = I
dotnet_naming_style.prefixo_i.capitalization = pascal_case
