@model Clouud.Web.ViewModels.VitrineViewModel

@{
    ViewData["Title"] = "Produtos";
    ViewData["ModoVitrine"] = "login";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-danger">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">CLOUUD </a>
        <style>
            .navbar-brand {
                font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
                font-size: 30px; /* Tamanho da fonte */
                font-weight: bold; /* Peso da fonte (negrito) */
                /* Outros estilos que você desejar */
            }

            a {
                margin-left: 15px;
            }
        </style>
        <form class="d-flex" role="search">
            <a asp-controller="Conta" asp-action="Login" class="btn btn-secondary">Entrar</a>
            <a asp-controller="Conta" asp-action="Cadastro" class="btn btn-secondary">Cadastrar</a>
        </form>
    </div>
</nav>

<div class="text-center">
    <div class="container">
        <div class="row">
            <div class="col-12 align-content-center">
                <img style="width:250px" src="~/img/nuuvem.png" />
            </div>
        </div>

        <partial name="_Vitrine" model="Model" view-data="ViewData" />
    </div>
</div>
