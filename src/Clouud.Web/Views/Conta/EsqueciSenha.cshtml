@model Clouud.Web.ViewModels.EsqueciSenhaViewModel
@{
    ViewData["Title"] = "Esqueci minha senha";
    var enviado = ViewData["Enviado"] as string;
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="painel-form">
            <h2>Esqueci minha senha</h2>
            @if (enviado != null)
            {
                <div class="alert alert-success" id="pedidoEnviado">
                    Se existir uma conta com <strong>@enviado</strong>, enviamos um link para criar uma nova senha.
                    Ele vale por 1 hora. Confira também a caixa de spam.
                </div>
                <p class="text-center mb-0"><a href="/conta/login">Voltar para o login</a></p>
            }
            else
            {
                <p class="text-muted">Informe o e-mail da sua conta. Vamos mandar um link para você criar uma nova senha.</p>
                <form method="post" action="/conta/esqueci-senha" asp-antiforgery="true">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center py-2">
                        <a href="/conta/login" class="btn btn-secondary">Voltar</a>
                        <input type="submit" value="Enviar link" class="btn btn-primary" />
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
