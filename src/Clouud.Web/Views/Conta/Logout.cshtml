@{
    ViewData["Title"] = "Sair";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="painel-form text-center">
            <h2>Sair da conta?</h2>
            <form method="post" action="/conta/logout" asp-antiforgery="true" class="d-flex gap-2 justify-content-center mt-3">
                <a href="/" class="btn btn-secondary">Voltar</a>
                <input type="submit" value="Sair" class="btn btn-primary" />
            </form>
        </div>
    </div>
</div>
