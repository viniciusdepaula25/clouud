@model Clouud.Web.ViewModels.ContaViewModel

@{
    ViewData["Title"] = "Cadastro";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="painel-form">
            <h2>Criar conta</h2>
            <p class="text-muted">Depois de criar a conta você já entra na loja.</p>
            <form asp-action="Cadastro">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label"></label>
                    <input asp-for="Nome" class="form-control" autocomplete="name" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Senha" class="form-label"></label>
                    <input asp-for="Senha" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>
                <div class="text-center py-2">
                    <input type="submit" value="Criar conta" class="btn btn-primary" />
                </div>
                <p class="text-center mt-3 mb-0">
                    <a asp-controller="Conta" asp-action="Login">Já tem conta? Entrar</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
