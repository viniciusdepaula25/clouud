@model Clouud.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="painel-form">
            <h2>Entrar</h2>
            <p class="text-muted">Entre com sua conta para comprar e ver suas chaves.</p>
            <partial name="_Alertas" />
            <form asp-action="Login">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label asp-for="Senha" class="form-label"></label>
                        <a href="/conta/esqueci-senha" class="small">Esqueci minha senha</a>
                    </div>
                    <input asp-for="Senha" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Senha" class="text-danger"></span>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-center py-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Voltar</a>
                    <input type="submit" value="Entrar" class="btn btn-primary" />
                </div>
                <p class="text-center mt-3 mb-0">
                    <a asp-action="Cadastro">Não tem conta? Cadastre-se</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
