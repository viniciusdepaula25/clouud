@model Clouud.Web.Services.Emails.EmailPedidoPagoViewModel
@{
    ViewData["Title"] = $"Pedido #{Model.PedidoId} aprovado";
    var botao = ("Ver o pedido na loja", Model.LinkPedido);
}
<h1 style="margin:0 0 12px;color:#ffffff;font-size:22px;">Pagamento aprovado, @Model.Nome!</h1>
@if (Model.ComChaves)
{
    <p style="margin:0 0 16px;">Obrigado pela compra. Estas são as chaves do <strong>pedido #@Model.PedidoId</strong>. Cada chave só pode ser ativada uma vez: não compartilhe os códigos.</p>
}
else
{
    <p style="margin:0 0 16px;">Obrigado pela compra do <strong>pedido #@Model.PedidoId</strong>. As chaves já estão em <a href="@Model.LinkMinhasChaves" style="color:#2a9fd6;">Minhas chaves</a>.
        Elas não vão neste e-mail porque o seu endereço ainda não foi confirmado: confirme em <strong>Minha conta</strong> para recebê-las por e-mail nas próximas compras.</p>
}

@foreach (var item in Model.Itens)
{
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 14px;background:#262626;border:1px solid #333;border-radius:6px;">
        <tr>
            <td style="padding:12px 14px;">
                <div style="color:#ffffff;font-weight:bold;font-size:16px;">@item.Jogo</div>
                <div style="color:#aaaaaa;font-size:13px;">@item.Plataforma@(item.Edicao != "Standard" ? $" · {item.Edicao}" : "") · @item.Quantidade × @item.PrecoUnitario.ToString("C")</div>
                @foreach (var chave in item.Chaves)
                {
                    <div class="chave" style="margin:8px 0 0;padding:8px 10px;background:#111111;border:1px dashed #555;border-radius:4px;font-family:Consolas,'Courier New',monospace;font-size:16px;color:#ffffff;letter-spacing:1px;">@chave</div>
                }
                @if (!string.IsNullOrWhiteSpace(item.ComoAtivar))
                {
                    <p style="margin:10px 0 0;font-size:13px;color:#cccccc;"><strong>Como ativar:</strong> @item.ComoAtivar</p>
                }
            </td>
        </tr>
    </table>
}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:6px 0 0;font-size:14px;">
    <tr><td style="padding:2px 0;color:#aaaaaa;">Subtotal</td><td align="right" style="padding:2px 0;">@Model.Subtotal.ToString("C")</td></tr>
    @if (Model.Desconto > 0)
    {
        <tr><td style="padding:2px 0;color:#aaaaaa;">Desconto@(Model.Cupom != null ? $" (cupom {Model.Cupom})" : "")</td><td align="right" style="padding:2px 0;">- @Model.Desconto.ToString("C")</td></tr>
    }
    <tr><td style="padding:6px 0 0;color:#ffffff;font-weight:bold;border-top:1px solid #333;">Total pago</td><td align="right" style="padding:6px 0 0;color:#ffffff;font-weight:bold;border-top:1px solid #333;">@Model.Total.ToString("C")</td></tr>
</table>

<partial name="~/Views/Emails/_Botao.cshtml" model="botao" />
<p style="margin:0;font-size:13px;color:#aaaaaa;">As chaves também ficam guardadas em <a href="@Model.LinkMinhasChaves" style="color:#2a9fd6;">Minhas chaves</a>. Pagamento simulado: nenhum valor foi cobrado.</p>
