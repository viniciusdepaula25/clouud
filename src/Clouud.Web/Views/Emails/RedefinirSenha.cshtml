@model Clouud.Web.Services.Emails.EmailRedefinirSenhaViewModel
@{
    ViewData["Title"] = "Redefinir sua senha";
    var botao = ("Criar uma nova senha", Model.Link);
}
<h1 style="margin:0 0 12px;color:#ffffff;font-size:22px;">Olá, @Model.Nome!</h1>
<p style="margin:0 0 4px;">Recebemos um pedido para redefinir a senha da sua conta na CLOUUD. Clique no botão para escolher uma nova senha:</p>
<partial name="~/Views/Emails/_Botao.cshtml" model="botao" />
<p style="margin:0 0 12px;font-size:13px;color:#aaaaaa;">Se o botão não funcionar, copie este endereço no navegador:<br /><a href="@Model.Link" style="color:#2a9fd6;word-break:break-all;">@Model.Link</a></p>
<p style="margin:0 0 8px;">O link vale por <strong>1 hora</strong> e só pode ser usado uma vez.</p>
<p style="margin:0;font-size:13px;color:#aaaaaa;">Não foi você? Pode ignorar este e-mail: sua senha continua a mesma.</p>
