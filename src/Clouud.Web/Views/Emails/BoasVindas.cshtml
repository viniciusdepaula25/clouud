@model Clouud.Web.Services.Emails.EmailConfirmacaoViewModel
@{
    ViewData["Title"] = Model.Cadastro ? "Bem-vindo(a) à CLOUUD" : "Confirme seu e-mail";
}
<h1 style="margin:0 0 12px;color:#ffffff;font-size:22px;">@(Model.Cadastro ? $"Olá, {Model.Nome}! Sua conta foi criada." : $"Olá, {Model.Nome}!")</h1>
@if (Model.Cadastro)
{
    <p style="margin:0 0 12px;">Agora você já pode comprar chaves para Steam, Epic Games, Battle.net e outras plataformas. As chaves aparecem na hora, depois do pagamento, em <strong>Minhas chaves</strong>.</p>
}
<p style="margin:0 0 4px;">Confirme que este e-mail é seu clicando no botão abaixo. Assim você passa a receber os avisos da lista de desejos (promoções e jogos que voltaram ao estoque).</p>
@{ var botao = ("Confirmar meu e-mail", Model.LinkConfirmacao); }
<partial name="~/Views/Emails/_Botao.cshtml" model="botao" />
<p style="margin:0 0 12px;font-size:13px;color:#aaaaaa;">Se o botão não funcionar, copie este endereço no navegador:<br /><a href="@Model.LinkConfirmacao" style="color:#2a9fd6;word-break:break-all;">@Model.LinkConfirmacao</a></p>
<p style="margin:0;font-size:13px;color:#aaaaaa;">O link vale por 7 dias. Se você não criou uma conta na CLOUUD, ignore este e-mail.</p>
