@model Clouud.Web.ViewModels.CardProdutoViewModel
@* Card de um produto (jogo + plataforma + edição), usado na loja e nas prateleiras da página inicial.
   Capa com o selo de desconto, o selo "Esgotado" e o coração da lista de desejos; embaixo título, plataforma,
   categorias, nota, preço e o botão Comprar. *@
@{
    var item = Model.Produto;
    var desejoTexto = Model.Desejado ? "Tirar da lista de desejos" : "Pôr na lista de desejos";
}
<article class="card card-produto h-100 @(item.Esgotado ? "esgotado" : null)">
    <div class="capa-produto">
        <a href="/jogo/@item.Slug" tabindex="-1" aria-hidden="true">
            <img src="@(string.IsNullOrEmpty(item.Capa) ? Url.Content("~/img/sem-capa.svg") : Url.Content($"~/uploads/{item.Capa}"))"
                 class="card-img-top capa-card" alt="@item.Titulo" loading="lazy" data-fallback="@Url.Content("~/img/sem-capa.svg")">
        </a>
        @if (item.EmPromocao)
        {
            <span class="badge selo-desconto">-@item.PercentualDesconto%</span>
        }
        @if (item.Esgotado)
        {
            <span class="badge selo-esgotado">Esgotado</span>
        }
        @* Coração: põe ou tira o jogo da lista de desejos *@
        @if (Model.ModoCarrinho)
        {
            <form asp-area="Cliente" asp-controller="ListaDesejos" asp-action="Alternar" method="post" class="m-0">
                <input type="hidden" name="jogoId" value="@item.JogoId" />
                <input type="hidden" name="voltarPara" value="@Model.VoltarPara" />
                <button type="submit" class="botao-desejo desejo" title="@desejoTexto" aria-label="@desejoTexto"
                        aria-pressed="@(Model.Desejado ? "true" : "false")">@(Model.Desejado ? "♥" : "♡")</button>
            </form>
        }
        else
        {
            <a asp-area="" asp-controller="Conta" asp-action="Login" asp-route-returnUrl="@Model.VoltarPara" class="botao-desejo"
               title="Entre para usar a lista de desejos" aria-label="Entre para usar a lista de desejos">♡</a>
        }
    </div>
    <div class="card-body">
        <h3 class="card-header" title="@item.Titulo"><a href="/jogo/@item.Slug">@item.Titulo</a></h3>
        <p class="card-title"><i class="bi bi-controller icone-plataforma" aria-hidden="true"></i>@item.Plataforma @(item.Edicao != "Standard" ? $"· {item.Edicao}" : "")</p>
        <div class="detalhes" title="@string.Join(", ", item.Categorias)">@(item.Desenvolvedora ?? "—")@(item.Categorias.Count > 0 ? " · " + string.Join(", ", item.Categorias) : "")</div>
        @if (item.MediaAvaliacoes.HasValue)
        {
            <div class="nota-card">
                <partial name="_Estrelas" model="item.MediaAvaliacoes.Value" />
                <span class="text-muted">@item.MediaAvaliacoes.Value.ToString("0.0") (@item.TotalAvaliacoes)</span>
            </div>
        }
        <div class="rodape-card">
            <div class="preco">
                @if (item.EmPromocao)
                {
                    <s>@item.Preco.ToString("C")</s>
                }
                <strong>@item.PrecoAtual.ToString("C")</strong>
            </div>
            @if (item.Esgotado)
            {
                <button class="btn btn-outline-secondary btn-sm" type="button" disabled>Esgotado</button>
            }
            else if (Model.ModoCarrinho)
            {
                <form asp-area="Cliente" asp-controller="Carrinho" asp-action="Adicionar" method="post" class="m-0">
                    <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                    <input type="hidden" name="voltarPara" value="@Model.VoltarPara" />
                    <button class="btn btn-danger btn-sm btn-comprar" type="submit"><i class="bi bi-cart-plus" aria-hidden="true"></i>Comprar</button>
                </form>
            }
            else
            {
                <a asp-area="" asp-controller="Conta" asp-action="Login" asp-route-returnUrl="@Model.VoltarPara"
                   class="btn btn-danger btn-sm btn-comprar" role="button"><i class="bi bi-cart-plus" aria-hidden="true"></i>Comprar</a>
            }
        </div>
    </div>
</article>
