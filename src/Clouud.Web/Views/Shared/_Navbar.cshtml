@* Barra da loja. Visitante: Entrar e Cadastrar. Logado: pedidos, chaves, lista de desejos, carrinho e conta.
   No celular os itens ficam num menu que abre pelo botão ☰. *@
@using System.Security.Claims
@inject Clouud.Web.Services.CarrinhoService Carrinho
@inject Clouud.Web.Services.ListaDesejosService Desejos
@inject Clouud.Web.Services.FotoPerfilService Fotos
@{
    var logado = int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var usuarioId);
    var admin = User.IsInRole("Admin");
    var unidadesNoCarrinho = logado ? Carrinho.ContarUnidades(usuarioId) : 0;
    var jogosDesejados = logado ? Desejos.Contar(usuarioId) : 0;
    var foto = logado ? Fotos.UrlDoUsuario(usuarioId) : Clouud.Web.Services.FotoPerfilService.FotoPadrao;
    var caminho = Context.Request.Path.Value ?? "/";
    var voltarAposLogin = caminho == "/" || caminho.StartsWith("/conta", StringComparison.OrdinalIgnoreCase) ? null : caminho + Context.Request.QueryString;
    var ativo = (string prefixo) => caminho.StartsWith(prefixo, StringComparison.OrdinalIgnoreCase) ? "active" : null;
}
<nav class="navbar navbar-expand-lg navbar-dark bg-danger barra-loja" aria-label="Navegação principal">
    <div class="container-fluid">
        <a class="navbar-brand marca" href="/">CLOUUD</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir o menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuPrincipal">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link @(caminho.Equals("/loja", StringComparison.OrdinalIgnoreCase) && !Context.Request.Query.ContainsKey("promocoes") ? "active" : null)" href="/loja">Loja</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Context.Request.Query.ContainsKey("promocoes") ? "active" : null)" href="/loja?promocoes=true">Promoções</a>
                </li>
                @if (logado)
                {
                    <li class="nav-item">
                        <a class="nav-link @ativo("/Cliente/Pedidos")" asp-area="Cliente" asp-controller="Pedidos" asp-action="Index">Meus pedidos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ativo("/Cliente/MinhasChaves")" asp-area="Cliente" asp-controller="MinhasChaves" asp-action="Index">Minhas chaves</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ativo("/Cliente/ListaDesejos")" asp-area="Cliente" asp-controller="ListaDesejos" asp-action="Index">Lista de desejos@(jogosDesejados > 0 ? $" ({jogosDesejados})" : "")</a>
                    </li>
                    @if (admin)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">Painel admin</a>
                        </li>
                    }
                }
            </ul>
            <form class="d-flex my-2 my-lg-0 me-lg-3 busca-barra" role="search" method="get" action="/loja">
                <input class="form-control form-control-sm" type="search" name="busca" placeholder="Buscar jogos" aria-label="Buscar jogos" />
            </form>
            <div class="d-flex align-items-center flex-wrap gap-2 pb-2 pb-lg-0">
                @if (logado)
                {
                    <a asp-area="Cliente" asp-controller="Carrinho" asp-action="Index" class="btn btn-dark btn-sm" id="linkCarrinho">
                        Carrinho
                        @if (unidadesNoCarrinho > 0)
                        {
                            <span class="badge rounded-pill bg-white text-black ms-1" id="contadorCarrinho">@unidadesNoCarrinho</span>
                        }
                    </a>
                    <a asp-area="Cliente" asp-controller="MinhaConta" asp-action="Index" title="Minha conta"
                       class="d-flex align-items-center gap-2 text-white text-decoration-none">
                        <span class="fw-semibold">@User.Identity?.Name</span>
                        <img src="@foto" class="rounded-circle foto-barra" alt="Minha conta"
                             onerror="this.onerror=null;this.src='@Clouud.Web.Services.FotoPerfilService.FotoPadrao'">
                    </a>
                    <form method="post" action="/conta/logout" asp-antiforgery="true" class="m-0">
                            <button type="submit" class="btn btn-secondary btn-sm" id="botaoSair">Sair</button>
                        </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Conta" asp-action="Login" asp-route-returnUrl="@voltarAposLogin" class="btn btn-secondary btn-sm">Entrar</a>
                    <a asp-area="" asp-controller="Conta" asp-action="Cadastro" class="btn btn-secondary btn-sm">Cadastrar</a>
                }
            </div>
        </div>
    </div>
</nav>
