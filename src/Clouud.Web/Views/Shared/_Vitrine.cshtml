@model Clouud.Web.ViewModels.VitrineViewModel
@*
    Filtros + cards de produtos da loja (a mesma para visitante e cliente).
    ViewData["ModoVitrine"]: "login" (visitante vai para o login) ou "carrinho" (cliente logado compra).
*@
@{
    var modoCarrinho = ViewData["ModoVitrine"] as string == "carrinho";
    var paginaAtual = Context.Request.Path + Context.Request.QueryString;
}

@{
    var filtro = Model.Filtro;
    // Link para outra página mantendo busca, filtros e ordem
    string UrlPagina(int numero)
    {
        var parametros = Context.Request.Query
            .Where(q => q.Key != "pagina")
            .SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string?>(q.Key, v)))
            .ToList();
        if (numero > 1)
        {
            parametros.Add(new("pagina", numero.ToString()));
        }
        return "/loja" + QueryString.Create(parametros);
    }
    string? ValorPreco(string nome, decimal? valor) =>
        valor.HasValue ? Dinheiro.ParaCampo(valor.Value) : Context.Request.Query[nome].FirstOrDefault();
}

<button class="btn btn-secondary botao-filtros d-md-none mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#painelFiltros"
        aria-expanded="@(filtro.TemFiltro ? "true" : "false")" aria-controls="painelFiltros">
    <i class="bi bi-funnel" aria-hidden="true"></i>Filtros@(filtro.TemFiltro ? " (ativos)" : "")
</button>
<div class="collapse d-md-block @(filtro.TemFiltro ? "show" : null)" id="painelFiltros">
    <form class="filtros-loja row g-3 align-items-end" method="get" action="/loja" id="filtrosLoja" role="search" aria-label="Filtros da loja">
        <div class="col-12 col-lg-4">
            <label class="form-label" for="txtBusca">Buscar</label>
            <input class="form-control" type="search" id="txtBusca" name="busca" value="@filtro.Busca" placeholder="Nome do jogo">
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="filtroPlataforma">Plataforma</label>
            <select class="form-select" name="plataforma" id="filtroPlataforma">
                <option value="">Todas</option>
                @foreach (var p in Model.Plataformas)
                {
                    <option value="@p.Slug" selected="@(p.Slug == filtro.Plataforma)">@p.Nome</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="filtroCategoria">Categoria</label>
            <select class="form-select" name="categoria" id="filtroCategoria">
                <option value="">Todas</option>
                @foreach (var c in Model.Categorias)
                {
                    <option value="@c.Slug" selected="@(c.Slug == filtro.Categoria)">@c.Nome</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="precoMin">Preço de (R$)</label>
            <input class="form-control" type="text" inputmode="decimal" id="precoMin" name="precoMin" value="@ValorPreco("precoMin", filtro.PrecoMin)" placeholder="0,00">
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="precoMax">até (R$)</label>
            <input class="form-control" type="text" inputmode="decimal" id="precoMax" name="precoMax" value="@ValorPreco("precoMax", filtro.PrecoMax)" placeholder="sem limite">
        </div>
        <div class="col-12 d-flex align-items-center gap-3 flex-wrap">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" role="switch" id="promocoes" name="promocoes" value="true" checked="@filtro.Promocoes">
                <label class="form-check-label" for="promocoes">Só promoções</label>
            </div>
            <div class="ms-md-auto d-flex align-items-center gap-3">
                @if (filtro.TemFiltro)
                {
                    <a href="/loja@(filtro.OrdemEfetiva != "destaques" ? $"?ordem={filtro.OrdemEfetiva}" : "")" class="link-suave small"><i class="bi bi-x-circle me-1" aria-hidden="true"></i>Limpar filtros</a>
                }
                <input type="submit" value="Buscar" class="btn btn-primary px-4" />
            </div>
        </div>
    </form>
</div>

<div class="barra-resultados">
    <p class="text-muted small" id="resumoLoja" aria-live="polite">
        @if (Model.TotalProdutos > 0)
        {
            @($"{Model.TotalProdutos} {(Model.TotalProdutos == 1 ? "produto encontrado" : "produtos encontrados")}")
            @if (Model.TotalPaginas > 1)
            {
                @($" · mostrando {Model.PrimeiroDaPagina}–{Model.UltimoDaPagina}")
            }
        }
    </p>
    <div class="ordem">
        <label class="form-label small" for="ordem">Ordenar por</label>
        <select class="form-select form-select-sm" name="ordem" id="ordem" form="filtrosLoja" data-enviar-ao-mudar>
            @foreach (var (valor, texto) in FiltroVitrine.Ordens)
            {
                <option value="@valor" selected="@(valor == filtro.OrdemEfetiva)">@texto</option>
            }
        </select>
    </div>
</div>

@if (Model.Produtos.Count == 0)
{
    <div class="estado-vazio my-4">
        <i class="bi bi-search" aria-hidden="true"></i>
        <p class="titulo-vazio">Nenhum jogo encontrado.</p>
        <p>Tente outro nome ou tire alguns filtros.</p>
        <a href="/loja" class="btn btn-danger">Ver todos os jogos</a>
    </div>
}

<div class="row g-3">
    @foreach (var item in Model.Produtos)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <partial name="_CardProduto" model="new CardProdutoViewModel(item, modoCarrinho, Model.JogosDesejados.Contains(item.JogoId), paginaAtual)" />
        </div>
    }
</div>

@if (Model.TotalPaginas > 1)
{
    var inicio = Math.Max(1, Model.Pagina - 2);
    var fim = Math.Min(Model.TotalPaginas, Model.Pagina + 2);
    <nav aria-label="Páginas da loja" class="my-5">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Pagina == 1 ? "disabled" : null)">
                <a class="page-link" href="@UrlPagina(Model.Pagina - 1)" aria-label="Página anterior"><i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior</a>
            </li>
            @if (inicio > 1)
            {
                <li class="page-item"><a class="page-link" href="@UrlPagina(1)">1</a></li>
                @if (inicio > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            @for (var n = inicio; n <= fim; n++)
            {
                <li class="page-item @(n == Model.Pagina ? "active" : null)">
                    <a class="page-link" href="@UrlPagina(n)" aria-current="@(n == Model.Pagina ? "page" : null)">@n</a>
                </li>
            }
            @if (fim < Model.TotalPaginas)
            {
                @if (fim < Model.TotalPaginas - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item"><a class="page-link" href="@UrlPagina(Model.TotalPaginas)">@Model.TotalPaginas</a></li>
            }
            <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : null)">
                <a class="page-link" href="@UrlPagina(Model.Pagina + 1)" aria-label="Próxima página">Próxima <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            </li>
        </ul>
    </nav>
}
