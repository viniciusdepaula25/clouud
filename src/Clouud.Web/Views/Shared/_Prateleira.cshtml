@model Clouud.Web.ViewModels.PrateleiraViewModel
@* Uma prateleira da página inicial: título, link "ver todos" e uma linha de cards *@
@if (Model.Produtos.Count > 0)
{
    <section class="prateleira" id="@Model.Id" aria-labelledby="titulo-@Model.Id">
        <div class="cabecalho-prateleira">
            <div>
                <h2 class="titulo-secao" id="titulo-@Model.Id">@Model.Titulo</h2>
                <small class="subtitulo-secao">@Model.Descricao</small>
            </div>
            <a href="@Model.LinkTodos" class="ver-todos">@Model.TextoTodos →</a>
        </div>
        <div class="row g-3">
            @foreach (var item in Model.Produtos)
            {
                var card = new CardProdutoViewModel(item, Model.ModoCarrinho, Model.JogosDesejados.Contains(item.JogoId), "/");
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_CardProduto" model="card" />
                </div>
            }
        </div>
    </section>
}
