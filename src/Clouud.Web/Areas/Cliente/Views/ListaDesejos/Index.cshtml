@model List<Clouud.Web.ViewModels.DesejoViewModel>

@{
    ViewData["Title"] = "Lista de desejos";
}

<div class="cabecalho-pagina">
    <div>
        <h1><i class="bi bi-heart me-2 text-danger" aria-hidden="true"></i>Lista de desejos</h1>
        <p class="subtitulo">Jogos que você está acompanhando: o preço de agora, as promoções e se há chave disponível.</p>
    </div>
</div>
<p class="small text-muted"><i class="bi bi-bell me-1" aria-hidden="true"></i>Quando um deles entrar em promoção ou voltar ao estoque, avisamos por e-mail
    (<a asp-controller="MinhaConta" asp-action="Index">ajuste em Minha conta</a>).</p>
<partial name="_Alertas" />

@if (Model.Count == 0)
{
    <div class="estado-vazio">
        <i class="bi bi-heart" aria-hidden="true"></i>
        <p class="titulo-vazio">Sua lista está vazia.</p>
        <p>Na loja, clique no <span class="text-danger">♡</span> de um jogo para acompanhá-lo aqui.</p>
        <a href="/loja" class="btn btn-danger">Ver jogos</a>
    </div>
}
@foreach (var desejo in Model)
{
    <article class="card mb-3 card-desejo" id="desejo-@desejo.JogoId">
        <div class="row g-0">
            <div class="col-md-4 col-lg-3">
                <a href="/jogo/@desejo.Slug" tabindex="-1" aria-hidden="true" class="d-block h-100">
                    <img src="@(string.IsNullOrEmpty(desejo.Capa) ? Url.Content("~/img/sem-capa.svg") : Url.Content("~/uploads/" + desejo.Capa))"
                         alt="" class="capa-desejo" data-fallback="@Url.Content("~/img/sem-capa.svg")" />
                </a>
            </div>
            <div class="col">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="min-w-0">
                            <h2 class="h5 card-title mb-1">
                                <a href="/jogo/@desejo.Slug" class="text-reset text-decoration-none">@desejo.Titulo</a>
                                @if (desejo.TemPromocao)
                                {
                                    <span class="badge bg-danger align-middle ms-1 fs-7">Em promoção</span>
                                }
                            </h2>
                            <small class="text-muted">
                                Na lista desde @desejo.AdicionadoEm.ToLocalTime().ToString("dd/MM/yyyy")
                                @if (desejo.MenorPreco.HasValue)
                                {
                                    <text>· a partir de <strong class="text-white">@desejo.MenorPreco.Value.ToString("C")</strong></text>
                                }
                            </small>
                        </div>
                        <form asp-action="Remover" method="post" class="m-0">
                            <input type="hidden" name="jogoId" value="@desejo.JogoId" />
                            <input type="submit" value="Remover" class="btn btn-outline-danger btn-sm" aria-label="Remover @desejo.Titulo da lista" />
                        </form>
                    </div>

                    @if (!desejo.JogoAtivo || desejo.Produtos.Count == 0)
                    {
                        <p class="text-muted mt-3 mb-0"><i class="bi bi-slash-circle me-1" aria-hidden="true"></i>No momento este jogo não está à venda.</p>
                    }
                    else
                    {
                        <div class="mt-3">
                            @foreach (var produto in desejo.Produtos)
                            {
                                <div class="linha-oferta">
                                    <span class="plataforma-oferta"><i class="bi bi-controller me-1 text-muted" aria-hidden="true"></i>@produto.Plataforma@(produto.Edicao != "Standard" ? $" · {produto.Edicao}" : "")</span>
                                    <span class="text-end text-nowrap">
                                        @if (produto.EmPromocao)
                                        {
                                            <span class="badge bg-danger">-@produto.PercentualDesconto%</span>
                                            <s class="text-muted small ms-1">@produto.Preco.ToString("C")</s>
                                        }
                                        <strong class="ms-1 text-white">@produto.PrecoAtual.ToString("C")</strong>
                                    </span>
                                    @if (produto.Esgotado)
                                    {
                                        <button class="btn btn-outline-secondary btn-sm" type="button" disabled>Esgotado</button>
                                    }
                                    else
                                    {
                                        <form asp-controller="Carrinho" asp-action="Adicionar" method="post" class="m-0">
                                            <input type="hidden" name="produtoId" value="@produto.ProdutoId" />
                                            <input type="hidden" name="voltarPara" value="/Cliente/ListaDesejos" />
                                            <button type="submit" class="btn btn-danger btn-sm"><i class="bi bi-cart-plus" aria-hidden="true"></i>Comprar</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </article>
}
