@model List<Clouud.Web.ViewModels.DesejoViewModel>

@{
    ViewData["Title"] = "Lista de desejos";
}

<h1 class="mt-3">Lista de desejos</h1>
<p>Jogos que você está acompanhando. Aqui aparecem o preço de agora, as promoções e se há chave disponível.</p>
<hr />
<partial name="_Alertas" />

@if (Model.Count == 0)
{
    <p>Sua lista está vazia. Na loja, clique no <span class="text-danger">♡</span> de um jogo para acompanhá-lo aqui.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Ver jogos</a>
}
@foreach (var desejo in Model)
{
    <div class="card mb-3" id="desejo-@desejo.JogoId">
        <div class="row g-0">
            <div class="col-3 col-md-2">
                <img src="@(string.IsNullOrEmpty(desejo.Capa) ? Url.Content("~/img/sem-capa.svg") : Url.Content("~/uploads/" + desejo.Capa))"
                     alt="" class="img-fluid rounded-start h-100" style="object-fit: cover; max-height: 180px; width: 100%"
                     onerror="this.onerror=null;this.src='@Url.Content("~/img/sem-capa.svg")'" />
            </div>
            <div class="col">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="card-title mb-1">
                                @desejo.Titulo
                                @if (desejo.TemPromocao)
                                {
                                    <span class="badge bg-danger fs-6 align-middle">Em promoção</span>
                                }
                            </h4>
                            <small class="text-muted">
                                Na lista desde @desejo.AdicionadoEm.ToLocalTime().ToString("dd/MM/yyyy")
                                @if (desejo.MenorPreco.HasValue)
                                {
                                    <text>· a partir de <strong class="text-white">@desejo.MenorPreco.Value.ToString("C")</strong></text>
                                }
                            </small>
                        </div>
                        <form asp-action="Remover" method="post">
                            <input type="hidden" name="jogoId" value="@desejo.JogoId" />
                            <input type="submit" value="Remover" class="btn btn-outline-danger btn-sm" />
                        </form>
                    </div>

                    @if (!desejo.JogoAtivo || desejo.Produtos.Count == 0)
                    {
                        <p class="text-muted mt-3 mb-0">No momento este jogo não está à venda.</p>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mt-3 mb-0">
                            <tbody>
                                @foreach (var produto in desejo.Produtos)
                                {
                                    <tr>
                                        <td>@produto.Plataforma@(produto.Edicao != "Standard" ? $" · {produto.Edicao}" : "")</td>
                                        <td class="text-end">
                                            @if (produto.EmPromocao)
                                            {
                                                <span class="badge bg-danger">-@produto.PercentualDesconto%</span>
                                                <s class="text-muted small ms-1">@produto.Preco.ToString("C")</s>
                                            }
                                            <strong class="ms-1">@produto.PrecoAtual.ToString("C")</strong>
                                        </td>
                                        <td class="text-end" style="width: 140px">
                                            @if (produto.Esgotado)
                                            {
                                                <button class="btn btn-outline-secondary btn-sm" type="button" disabled>Esgotado</button>
                                            }
                                            else
                                            {
                                                <form asp-controller="Carrinho" asp-action="Adicionar" method="post">
                                                    <input type="hidden" name="produtoId" value="@produto.ProdutoId" />
                                                    <input type="hidden" name="voltarPara" value="/Cliente/ListaDesejos" />
                                                    <button type="submit" class="btn btn-danger btn-sm">Comprar</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}
