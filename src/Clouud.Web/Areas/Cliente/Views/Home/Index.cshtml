@model Clouud.Web.ViewModels.VitrineViewModel

@{
    ViewData["Title"] = "Produtos";
    ViewData["ModoVitrine"] = "carrinho";
}


<div class="text-center">
    <div class="container">
        <div class="row">
            <div class="col-12 align-content-center">
                <img style="width:250px" src="~/img/nuuvem.png" />
            </div>
        </div>

        @if (TempData["Erro"] is string erro)
        {
            <div class="alert alert-danger">@erro</div>
        }
        <partial name="_Vitrine" model="Model" view-data="ViewData" />
    </div>
</div>
