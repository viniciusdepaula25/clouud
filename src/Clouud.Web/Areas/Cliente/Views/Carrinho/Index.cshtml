@model Clouud.Web.ViewModels.CarrinhoViewModel
@inject Clouud.Web.Services.PedidoService Pedidos
@using Clouud.Web.Models

@{
    ViewData["Title"] = "Carrinho";
}

<h1 class="mt-3">Meu carrinho</h1>
<hr />
<partial name="_Alertas" />

@if (Model.Itens.Count == 0)
{
    <p>Seu carrinho está vazio.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Ver jogos</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th colspan="2">Produto</th>
                <th class="text-end">Preço</th>
                <th>Quantidade</th>
                <th class="text-end">Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens)
            {
                <tr>
                    <td style="width: 64px">
                        <img src="@(string.IsNullOrEmpty(item.Capa) ? Url.Content("~/img/sem-capa.svg") : Url.Content("~/uploads/" + item.Capa))"
                             alt="" width="48" height="64" style="object-fit: cover"
                             onerror="this.onerror=null;this.src='@Url.Content("~/img/sem-capa.svg")'" />
                    </td>
                    <td>
                        <strong>@item.Titulo</strong><br />
                        <small class="text-muted">@item.Plataforma@(item.Edicao != "Standard" ? $" · {item.Edicao}" : "")</small>
                        @if (item.Problema != null)
                        {
                            <div class="text-danger small">@item.Problema</div>
                        }
                    </td>
                    <td class="text-end">
                        @if (item.EmPromocao)
                        {
                            <s class="text-muted small">@item.Preco.ToString("C")</s><br />
                        }
                        @item.PrecoAtual.ToString("C")
                    </td>
                    <td>
                        <form asp-action="Atualizar" method="post" class="d-flex gap-1">
                            <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                            <select name="quantidade" class="form-select form-select-sm" style="width: 80px" aria-label="Quantidade"
                                    onchange="this.form.submit()">
                                @for (var q = 1; q <= CarrinhoItem.QuantidadeMaxima; q++)
                                {
                                    <option value="@q" selected="@(q == item.Quantidade)">@q</option>
                                }
                            </select>
                            <noscript><input type="submit" value="OK" class="btn btn-secondary btn-sm" /></noscript>
                        </form>
                    </td>
                    <td class="text-end">@item.Subtotal.ToString("C")</td>
                    <td class="text-end">
                        <form asp-action="Remover" method="post">
                            <input type="hidden" name="produtoId" value="@item.ProdutoId" />
                            <input type="submit" value="Remover" class="btn btn-outline-danger btn-sm" />
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Total</th>
                <th class="text-end fs-5" id="totalCarrinho">@Model.Total.ToString("C")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <a asp-controller="Home" asp-action="Index">Continuar comprando</a>
        <form asp-action="Finalizar" method="post" class="text-end">
            <small class="d-block text-muted mb-1">
                Ao finalizar, as chaves ficam reservadas por @((int)Pedidos.PrazoPagamento.TotalMinutes) minutos para você pagar.
            </small>
            <input type="submit" value="Finalizar compra" class="btn btn-danger btn-lg" disabled="@(!Model.PodeFinalizar)" />
        </form>
    </div>
}
