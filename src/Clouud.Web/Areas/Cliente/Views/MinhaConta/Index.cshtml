@model Clouud.Web.ViewModels.MinhaContaViewModel
@using Clouud.Web.Services

@{
    ViewData["Title"] = "Minha conta";
}


<div class="cabecalho-pagina">
    <div>
        <h1><i class="bi bi-person-circle me-2 text-danger" aria-hidden="true"></i>Minha conta</h1>
        <p class="subtitulo">Seus dados, a senha e os avisos por e-mail.</p>
    </div>
</div>
<partial name="_Alertas" />

<div class="row g-4 align-items-start">
    <aside class="col-lg-4">
        <section class="painel text-center mb-4" aria-labelledby="tituloFoto">
            <img src="@FotoPerfilService.Url(Model.Foto)" alt="Sua foto de perfil" id="fotoPerfil"
                 class="rounded-circle foto-conta mb-3" data-fallback="@FotoPerfilService.FotoPadrao" />
            <h2 class="h5 mb-1" id="tituloFoto">@Model.Nome</h2>
            <p class="small text-muted mb-2 text-break">@Model.Email</p>
            @* Confirmação do e-mail: sem ela não vão os avisos da lista de desejos *@
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mb-3 small" id="statusEmail">
                @if (Model.EmailConfirmado)
                {
                    <span class="situacao situacao-sucesso">E-mail confirmado</span>
                }
                else
                {
                    <span class="situacao situacao-aviso">E-mail não confirmado</span>
                    <form asp-action="ReenviarConfirmacao" method="post" class="m-0">
                        <input type="submit" value="Reenviar e-mail de confirmação" class="btn btn-link btn-sm p-0" />
                    </form>
                }
            </div>
            <form asp-action="Foto" method="post" enctype="multipart/form-data" class="text-start">
                <label for="arquivoFoto" class="form-label">Foto de perfil</label>
                <input type="file" name="arquivo" id="arquivoFoto" class="form-control form-control-sm"
                       accept="image/jpeg,image/png,image/gif,image/webp" required />
                <small class="form-text d-block">JPG, PNG, GIF ou WebP, até 2 MB. A prévia aparece acima antes de enviar.</small>
                <span class="text-danger small d-block" id="erroFoto"></span>
                <div class="d-flex flex-wrap align-items-center gap-3 mt-2">
                    <input type="submit" value="Enviar foto" class="btn btn-secondary btn-sm" />
                </div>
            </form>
            @if (!string.IsNullOrEmpty(Model.Foto))
            {
                <form asp-action="RemoverFoto" method="post" class="mt-2 text-start">
                    <input type="submit" value="Remover foto" class="btn btn-link btn-sm text-danger p-0" />
                </form>
            }
        </section>

        <section class="painel" aria-labelledby="tituloAparelhos">
            <h2 class="painel-titulo" id="tituloAparelhos"><i class="bi bi-laptop" aria-hidden="true"></i>Aparelhos conectados</h2>
            <p class="small text-muted mb-3">Entrou num computador que não é seu e esqueceu de sair? Isto desconecta a sua conta de todos os outros aparelhos.</p>
            <form asp-action="SairDeTodos" method="post">
                <input type="submit" value="Sair de todos os outros aparelhos" class="btn btn-outline-danger btn-sm" />
            </form>
        </section>
    </aside>

    <div class="col-lg-8">
        <form asp-action="Index" method="post" class="form-admin">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <fieldset class="mb-4">
                <legend>Dados</legend>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input asp-for="ReceberAvisos" class="form-check-input" role="switch" />
                    <label asp-for="ReceberAvisos" class="form-check-label"></label>
                    @if (!Model.EmailConfirmado)
                    {
                        <small class="d-block text-muted">Os avisos só vão depois que você confirmar o e-mail.</small>
                    }
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend>Trocar senha <span class="text-lowercase fw-normal">(opcional)</span></legend>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NovaSenha" class="form-label"></label>
                        <input asp-for="NovaSenha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NovaSenha" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmarNovaSenha" class="form-label"></label>
                        <input asp-for="ConfirmarNovaSenha" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarNovaSenha" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Confirmação</legend>
                <div class="row">
                    <div class="col-md-6">
                        <label asp-for="SenhaAtual" class="form-label"></label>
                        <input asp-for="SenhaAtual" class="form-control" autocomplete="current-password" />
                        <small class="form-text">Obrigatória só para trocar o e-mail ou a senha.</small>
                        <span asp-validation-for="SenhaAtual" class="text-danger d-block"></span>
                    </div>
                </div>
            </fieldset>

            <div class="rodape-form">
                <a asp-area="Cliente" asp-controller="Home" asp-action="Index" class="btn btn-secondary">Voltar</a>
                <input type="submit" value="Salvar" class="btn btn-primary px-4" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Mostra a foto escolhida antes de enviar e avisa na hora se passar de 2 MB
        (function () {
            const campo = document.getElementById("arquivoFoto");
            const erro = document.getElementById("erroFoto");
            const limite = @FotoPerfilService.TamanhoMaximo;
            campo.addEventListener("change", () => {
                erro.textContent = "";
                const arquivo = campo.files[0];
                if (!arquivo) return;
                if (arquivo.size > limite) {
                    erro.textContent = "A imagem pode ter no máximo 2 MB.";
                    campo.value = "";
                    return;
                }
                document.getElementById("fotoPerfil").src = URL.createObjectURL(arquivo);
            });
        })();
    </script>
}
