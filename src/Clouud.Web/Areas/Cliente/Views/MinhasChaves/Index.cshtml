@model IEnumerable<Clouud.Web.Models.Chave>

@{
    ViewData["Title"] = "Minhas chaves";
    // Agrupadas por pedido, do mais novo para o mais antigo
    var grupos = Model.GroupBy(c => c.PedidoItem!.PedidoId).OrderByDescending(g => g.Max(c => c.VendidaEm)).ToList();
}

<div class="cabecalho-pagina">
    <div>
        <h1><i class="bi bi-key me-2 text-danger" aria-hidden="true"></i>Minhas chaves</h1>
        <p class="subtitulo">Todas as chaves dos seus pedidos pagos.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="estado-vazio">
        <i class="bi bi-key" aria-hidden="true"></i>
        <p class="titulo-vazio">Você ainda não tem chaves.</p>
        <p>Elas aparecem aqui assim que o pagamento de um pedido é aprovado.</p>
        <a href="/loja" class="btn btn-danger">Ver jogos</a>
    </div>
}
else
{
    <div class="alert alert-warning alert-com-icone">
        <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
        <div>Não compartilhe os códigos: cada chave só pode ser ativada uma vez.</div>
    </div>

    @foreach (var grupo in grupos)
    {
        <section class="painel grupo-chaves" aria-labelledby="pedido-@grupo.Key">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="painel-titulo mb-0" id="pedido-@grupo.Key"><i class="bi bi-receipt" aria-hidden="true"></i>Pedido #@grupo.Key</h2>
                <div class="small text-muted">
                    Comprado em @grupo.Max(c => c.VendidaEm)?.ToLocalTime().ToString("dd/MM/yyyy")
                    · <a asp-controller="Pedidos" asp-action="Detalhes" asp-route-id="@grupo.Key">Pedido #@grupo.Key</a>
                </div>
            </div>
            @foreach (var chave in grupo)
            {
                var plataforma = chave.Produto.Plataforma;
                <div class="mb-3">
                    <div class="d-flex flex-wrap align-items-baseline gap-2 mb-1">
                        <strong class="text-white">@chave.Produto.Jogo.Titulo@(chave.Produto.Edicao != "Standard" ? $" ({chave.Produto.Edicao})" : "")</strong>
                        <span class="small text-muted"><i class="bi bi-controller me-1" aria-hidden="true"></i>@plataforma.Nome</span>
                    </div>
                    <div class="chave-entregue">
                        <i class="bi bi-key text-muted" aria-hidden="true"></i>
                        <code id="chave-@chave.Id">@chave.Codigo</code>
                        <button type="button" class="btn btn-outline-primary btn-sm" data-copiar="chave-@chave.Id"><i class="bi bi-clipboard" aria-hidden="true"></i>Copiar</button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(plataforma.InstrucoesAtivacao))
                    {
                        <details class="como-ativar mt-1">
                            <summary>Como ativar</summary>
                            <p class="small text-muted mb-0 mt-1 passo-a-passo">@plataforma.InstrucoesAtivacao</p>
                        </details>
                    }
                </div>
            }
        </section>
    }
}

@section Scripts {
    <partial name="_CopiarChave" />
}
