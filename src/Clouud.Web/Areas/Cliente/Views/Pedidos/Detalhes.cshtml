@model Clouud.Web.Models.Pedido
@using Clouud.Web.Models

@{
    ViewData["Title"] = $"Pedido #{Model.Id}";
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Meus pedidos</a> / Pedido #@Model.Id</nav>
        <h1 class="d-flex flex-wrap align-items-center gap-3">
            Pedido #@Model.Id
            <span class="@Model.Status.Cor() fs-6">@Model.Status.Descricao()</span>
        </h1>
        <p class="subtitulo">
            Feito em @Model.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            @if (Model.PagoEm.HasValue)
            {
                <text>· pago em @Model.PagoEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</text>
            }
        </p>
    </div>
    <div class="acoes"><a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i>Voltar aos pedidos</a></div>
</div>
<partial name="_Alertas" />

@if (Model.Status == StatusPedido.AguardandoPagamento)
{
    <div class="alert alert-warning d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span><i class="bi bi-hourglass-split me-2" aria-hidden="true"></i>Aguardando pagamento até @Model.PagarAte?.ToLocalTime().ToString("dd/MM/yyyy HH:mm").</span>
        <a asp-action="Pagar" asp-route-id="@Model.Id" class="btn btn-danger">Pagar agora</a>
    </div>
}
else if (Model.Status == StatusPedido.Reembolsado)
{
    <div class="alert alert-info">Este pedido foi reembolsado e as chaves foram desativadas.</div>
}
else if (Model.Status == StatusPedido.Cancelado)
{
    <div class="alert alert-secondary">Este pedido foi cancelado. Nenhum valor foi cobrado.</div>
}

<div class="row g-4 align-items-start">
    <div class="@(Model.Status == StatusPedido.Pago ? "col-lg-7" : "col-12")">
        @if (Model.Status == StatusPedido.Pago)
        {
            <section aria-labelledby="tituloChaves">
                <h2 class="titulo-secao mb-3" id="tituloChaves">Suas chaves</h2>
                @foreach (var item in Model.Itens.OrderBy(i => i.Id))
                {
                    var chaves = item.Chaves.Where(c => c.Status == StatusChave.Vendida).OrderBy(c => c.Id).ToList();
                    <div class="card mb-3">
                        <div class="card-header d-flex align-items-center gap-2">
                            <i class="bi bi-controller text-danger" aria-hidden="true"></i>
                            <span><strong class="text-white">@item.Produto.Jogo.Titulo</strong> — @item.Produto.Plataforma.Nome@(item.Produto.Edicao != "Standard" ? $" · {item.Produto.Edicao}" : "")</span>
                        </div>
                        <div class="card-body">
                            @if (chaves.Count == 0)
                            {
                                <p class="text-muted mb-0">Pedido feito antes da entrega automática de chaves: não há chave registrada para este item.</p>
                            }
                            @foreach (var chave in chaves)
                            {
                                <div class="chave-entregue mb-2">
                                    <i class="bi bi-key text-muted" aria-hidden="true"></i>
                                    <code id="chave-@chave.Id">@chave.Codigo</code>
                                    <button type="button" class="btn btn-outline-primary btn-sm" data-copiar="chave-@chave.Id"><i class="bi bi-clipboard" aria-hidden="true"></i>Copiar</button>
                                </div>
                            }
                            @if (chaves.Count > 0 && !string.IsNullOrWhiteSpace(item.Produto.Plataforma.InstrucoesAtivacao))
                            {
                                <details class="como-ativar mt-2" open>
                                    <summary>Como ativar no @item.Produto.Plataforma.Nome</summary>
                                    <p class="small text-muted mb-0 mt-2 passo-a-passo">@item.Produto.Plataforma.InstrucoesAtivacao</p>
                                </details>
                            }
                        </div>
                    </div>
                }
                <p><a asp-controller="MinhasChaves" asp-action="Index"><i class="bi bi-key me-1" aria-hidden="true"></i>Ver todas as minhas chaves</a></p>
            </section>
        }
    </div>
    <div class="@(Model.Status == StatusPedido.Pago ? "col-lg-5" : "col-12")">
        <section class="painel mb-4" aria-labelledby="tituloItens">
            <h2 class="painel-titulo" id="tituloItens"><i class="bi bi-receipt" aria-hidden="true"></i>Itens</h2>
            <partial name="_Itens" model="Model" />
        </section>

    </div>
</div>

@{
    var pagamentos = Model.Pagamentos.OrderBy(p => p.CriadoEm).ToList();
}
@if (pagamentos.Count > 0)
{
    <section class="painel" aria-labelledby="tituloPagamentos">
        <h2 class="painel-titulo" id="tituloPagamentos"><i class="bi bi-credit-card" aria-hidden="true"></i>Pagamentos</h2>
        <div class="table-responsive">
            <table class="table table-sm small align-middle">
                <thead>
                    <tr><th>Data</th><th>Forma</th><th>Resultado</th><th>Transação</th><th class="text-end">Valor</th></tr>
                </thead>
                <tbody>
                    @foreach (var pagamento in pagamentos)
                    {
                        <tr>
                            <td class="text-nowrap">@pagamento.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@pagamento.Metodo.Descricao()</td>
                            <td>@if (pagamento.Status == StatusPagamento.Aprovado) { <span class="situacao situacao-sucesso">Aprovado</span> } else { <span class="situacao situacao-perigo">Recusado</span> }</td>
                            <td class="font-monospace">@pagamento.CodigoTransacao</td>
                            <td class="text-end text-nowrap">@pagamento.Valor.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@section Scripts {
    <partial name="_CopiarChave" />
}
