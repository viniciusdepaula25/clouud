@model Clouud.Web.Models.Pedido
@* Itens do pedido (produto, quantidade e preço pago) e os totais *@
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Produto</th>
                <th class="text-end">Qtd.</th>
                <th class="text-end d-none d-xl-table-cell">Preço unitário</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Itens.OrderBy(i => i.Id))
            {
                <tr>
                    <td>
                        <span class="titulo-linha fw-semibold">@item.Produto.Jogo.Titulo</span>
                        <small class="text-muted d-block">@item.Produto.Plataforma.Nome@(item.Produto.Edicao != "Standard" ? $" · {item.Produto.Edicao}" : "")</small>
                    </td>
                    <td class="text-end">@item.Quantidade</td>
                    <td class="text-end text-nowrap d-none d-xl-table-cell">@item.PrecoUnitario.ToString("C")</td>
                    <td class="text-end text-nowrap">@item.Subtotal.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            @if (Model.Desconto > 0)
            {
                <tr>
                    <td class="d-none d-xl-table-cell"></td><td colspan="2" class="text-end">Subtotal</td>
                    <td class="text-end text-nowrap">@Model.Subtotal.ToString("C")</td>
                </tr>
                <tr>
                    <td class="d-none d-xl-table-cell"></td><td colspan="2" class="text-end">Desconto@(Model.Cupom != null ? $" (cupom {Model.Cupom.Codigo})" : "")</td>
                    <td class="text-end text-nowrap text-success">- @Model.Desconto.ToString("C")</td>
                </tr>
            }
            <tr>
                <th class="d-none d-xl-table-cell border-0"></th><th colspan="2" class="text-end text-white border-0">Total</th>
                <th class="text-end text-white fs-5 text-nowrap border-0">@Model.Total.ToString("C")</th>
            </tr>
        </tfoot>
    </table>
</div>
