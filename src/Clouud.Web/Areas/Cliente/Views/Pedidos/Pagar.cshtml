@inject Clouud.Web.Services.PedidoService Pedidos
@model Clouud.Web.Models.Pedido
@using Clouud.Web.Models

@{
    ViewData["Title"] = "Pagamento";
    var prazo = Model.PagarAte!.Value;
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Meus pedidos</a> / Pedido #@Model.Id</nav>
        <h1>Pagamento do pedido #@Model.Id</h1>
    </div>
</div>
<partial name="_Alertas" />

<div class="alert alert-warning alert-com-icone">
    <i class="bi bi-hourglass-split" aria-hidden="true"></i>
    <div>
        Suas chaves estão reservadas até <strong>@prazo.ToLocalTime().ToString("HH:mm")</strong>
        (<span id="tempoRestante" class="contagem" data-prazo="@prazo.ToString("o")"></span>).
        Depois disso o pedido é cancelado e as chaves voltam para a loja.
    </div>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-7">
        <section class="painel" aria-labelledby="tituloResumo">
            <h2 class="painel-titulo" id="tituloResumo"><i class="bi bi-receipt" aria-hidden="true"></i>Resumo</h2>
            <partial name="_Itens" model="Model" />
        </section>
    </div>
    <div class="col-lg-5">
        <section class="painel" aria-labelledby="tituloForma">
            <h2 class="painel-titulo" id="tituloForma"><i class="bi bi-credit-card" aria-hidden="true"></i>Forma de pagamento</h2>
            <form asp-action="Pagar" asp-route-id="@Model.Id" method="post">
                <fieldset class="metodos-pagamento mb-3">
                    <legend class="visually-hidden">Forma de pagamento</legend>
                    @foreach (var metodo in Enum.GetValues<MetodoPagamento>())
                    {
                        var icone = metodo switch { MetodoPagamento.Pix => "bi-qr-code", MetodoPagamento.Cartao => "bi-credit-card-2-front", _ => "bi-upc-scan" };
                        <div class="metodo">
                            <input type="radio" name="metodo" id="metodo-@metodo" value="@metodo" checked="@(metodo == MetodoPagamento.Pix)" />
                            <label for="metodo-@metodo"><i class="bi @icone" aria-hidden="true"></i>@metodo.Descricao()</label>
                        </div>
                    }
                </fieldset>
                @if (Pedidos.PagamentoSimulado)
                {
                    <div class="aviso-simulacao small mb-3">
                        <strong><i class="bi bi-cone-striped me-1" aria-hidden="true"></i>Pagamento simulado.</strong> A loja ainda não está ligada a uma operadora de pagamento:
                        nenhum dado de pagamento é pedido e nada é cobrado. Use os botões abaixo para simular a resposta.
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" name="aprovar" value="true" class="btn btn-danger btn-lg">
                            <i class="bi bi-check2-circle" aria-hidden="true"></i>Pagar @Model.Total.ToString("C") (simular aprovação)
                        </button>
                        <button type="submit" name="aprovar" value="false" class="btn btn-outline-secondary">
                            Simular pagamento recusado
                        </button>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning my-3" id="pagamentoIndisponivel">
                        O pagamento online ainda não está disponível. As chaves ficam reservadas até o fim do prazo.
                    </div>
                }
            </form>

            @if (Model.Pagamentos.Any())
            {
                <h3 class="h6 mt-4 text-white">Tentativas anteriores</h3>
                <ul class="small mb-0">
                    @foreach (var pagamento in Model.Pagamentos.OrderBy(p => p.CriadoEm))
                    {
                        <li>@pagamento.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm") — @pagamento.Metodo.Descricao(): recusado</li>
                    }
                </ul>
            }

            <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post" class="mt-4 pt-3 border-top"
                  data-confirmar="Cancelar este pedido? As chaves voltam para a loja.">
                <input type="submit" value="Cancelar pedido" class="btn btn-link text-danger p-0" />
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // Contagem regressiva do prazo de pagamento
        (function () {
            const campo = document.getElementById("tempoRestante");
            const prazo = new Date(campo.dataset.prazo);
            const atualizar = () => {
                const segundos = Math.max(0, Math.floor((prazo - new Date()) / 1000));
                const m = Math.floor(segundos / 60), s = segundos % 60;
                campo.textContent = segundos > 0 ? `faltam ${m}:${String(s).padStart(2, "0")}` : "prazo encerrado";
            };
            atualizar();
            setInterval(atualizar, 1000);
        })();
    </script>
}
