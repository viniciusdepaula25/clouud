@model IEnumerable<Clouud.Web.Models.Pedido>
@using Clouud.Web.Models

@{
    ViewData["Title"] = "Meus pedidos";
}

<h1 class="mt-3">Meus pedidos</h1>
<hr />
<partial name="_Alertas" />

@if (!Model.Any())
{
    <p>Você ainda não fez nenhum pedido.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Ver jogos</a>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Pedido</th>
                <th>Data</th>
                <th>Jogos</th>
                <th class="text-end">Total</th>
                <th>Situação</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pedido in Model)
            {
                <tr>
                    <td>#@pedido.Id</td>
                    <td>@pedido.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@string.Join(", ", pedido.Itens.Select(i => i.Produto.Jogo.Titulo).Distinct())</td>
                    <td class="text-end">@pedido.Total.ToString("C")</td>
                    <td><span class="badge @pedido.Status.Cor()">@pedido.Status.Descricao()</span></td>
                    <td class="text-end">
                        @if (pedido.Status == StatusPedido.AguardandoPagamento)
                        {
                            <a asp-action="Pagar" asp-route-id="@pedido.Id" class="btn btn-danger btn-sm">Pagar</a>
                        }
                        <a asp-action="Detalhes" asp-route-id="@pedido.Id" class="btn btn-secondary btn-sm">Ver</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
