@model IEnumerable<Clouud.Web.Models.Pedido>
@using Clouud.Web.Models

@{
    ViewData["Title"] = "Meus pedidos";
}

<div class="cabecalho-pagina">
    <div>
        <h1><i class="bi bi-receipt me-2 text-danger" aria-hidden="true"></i>Meus pedidos</h1>
        <p class="subtitulo">Acompanhe o pagamento e veja as chaves de cada compra.</p>
    </div>
</div>
<partial name="_Alertas" />

@if (!Model.Any())
{
    <div class="estado-vazio">
        <i class="bi bi-bag" aria-hidden="true"></i>
        <p class="titulo-vazio">Você ainda não fez nenhum pedido.</p>
        <p>Quando comprar, os pedidos e as chaves aparecem aqui.</p>
        <a href="/loja" class="btn btn-danger">Ver jogos</a>
    </div>
}
else
{
    <div class="tabela-painel">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Data</th>
                        <th>Jogos</th>
                        <th class="text-end">Total</th>
                        <th>Situação</th>
                        <th><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-white">#@pedido.Id</td>
                            <td class="text-nowrap">@pedido.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@string.Join(", ", pedido.Itens.Select(i => i.Produto.Jogo.Titulo).Distinct())</td>
                            <td class="text-end text-nowrap text-white">@pedido.Total.ToString("C")</td>
                            <td><span class="@pedido.Status.Cor()">@pedido.Status.Descricao()</span></td>
                            <td>
                                <div class="acoes-linha">
                                    @if (pedido.Status == StatusPedido.AguardandoPagamento)
                                    {
                                        <a asp-action="Pagar" asp-route-id="@pedido.Id" class="btn btn-danger btn-sm">Pagar</a>
                                    }
                                    <a asp-action="Detalhes" asp-route-id="@pedido.Id" class="btn btn-secondary btn-sm">Ver</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
