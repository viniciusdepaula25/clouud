@model IEnumerable<Clouud.Web.Models.Cupom>

@{
    ViewData["Title"] = "Cupons";
    var usos = ViewData["Usos"] as Dictionary<int, (int Usos, decimal Descontos)> ?? new();
    var hoje = DateOnly.FromDateTime(DateTime.Today);
}

<div class="cabecalho-pagina">
    <div>
        <h1>Cupons de desconto</h1>
        <p class="subtitulo">O cliente digita o código no carrinho. Cada pedido usa no máximo um cupom; pedidos cancelados ou reembolsados devolvem o uso.</p>
    </div>
    <div class="acoes">
        <a class="btn btn-danger" asp-action="Inclui"><i class="bi bi-plus-lg" aria-hidden="true"></i>Cadastre um Cupom</a>
    </div>
</div>
<partial name="_Alertas" />
<div class="tabela-painel">
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Código</th>
            <th>Desconto</th>
            <th>Pedido mínimo</th>
            <th>Validade</th>
            <th class="text-end">Usos</th>
            <th class="text-end">Descontos dados</th>
            <th>Situação</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="text-center text-muted py-4">Nenhum cupom cadastrado.</td></tr>
        }
        @foreach (var cupom in Model)
        {
            var (quantidade, descontos) = usos.GetValueOrDefault(cupom.Id);
            var vencido = cupom.ValidoAte.HasValue && cupom.ValidoAte < hoje;
            var esgotado = cupom.LimiteUsos.HasValue && quantidade >= cupom.LimiteUsos;
            <tr>
                <td>
                    <span class="font-monospace fw-bold text-white">@cupom.Codigo</span>
                    @if (cupom.Descricao != null)
                    {
                        <br /><small class="text-muted">@cupom.Descricao</small>
                    }
                </td>
                <td>@cupom.DescreverDesconto()</td>
                <td>@(cupom.PedidoMinimo?.ToString("C") ?? "—")</td>
                <td>
                    @if (cupom.ValidoDe == null && cupom.ValidoAte == null)
                    {
                        <text>Sem prazo</text>
                    }
                    else
                    {
                        @($"{cupom.ValidoDe?.ToString("dd/MM/yyyy") ?? "…"} a {cupom.ValidoAte?.ToString("dd/MM/yyyy") ?? "…"}")
                    }
                </td>
                <td class="text-end">@quantidade@(cupom.LimiteUsos.HasValue ? $" / {cupom.LimiteUsos}" : "")</td>
                <td class="text-end text-nowrap">@descontos.ToString("C")</td>
                <td>
                    @if (!cupom.Ativo)
                    {
                        <span class="situacao situacao-neutra">Inativo</span>
                    }
                    else if (vencido)
                    {
                        <span class="situacao situacao-perigo">Vencido</span>
                    }
                    else if (esgotado)
                    {
                        <span class="situacao situacao-aviso">Esgotado</span>
                    }
                    else
                    {
                        <span class="situacao situacao-sucesso">Ativo</span>
                    }
                </td>
                <td>
                    <div class="acoes-linha">
                        <a asp-action="Altera" asp-route-id="@cupom.Id" class="btn btn-secondary btn-sm">Alterar</a>
                        <a asp-action="Exclui" asp-route-id="@cupom.Id" class="btn btn-outline-danger btn-sm">Excluir</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
