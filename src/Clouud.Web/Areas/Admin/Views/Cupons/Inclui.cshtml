@model Clouud.Web.Models.Cupom

@{
    ViewData["Title"] = "Cadastrar cupom";
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Cupons</a> / Cadastrar</nav>
        <h1>Cadastrar cupom</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-10 col-xl-9">
        <form asp-action="Inclui" class="form-admin">
            <partial name="_Form" model="Model" />
            <div class="rodape-form">
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                <input type="submit" value="Cadastrar" class="btn btn-primary px-4" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
