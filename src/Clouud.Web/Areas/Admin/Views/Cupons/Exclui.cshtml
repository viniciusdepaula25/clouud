@model Clouud.Web.Models.Cupom

@{
    ViewData["Title"] = "Exclui";
}

<h1>Exclui</h1>

<h3>Tem certeza que deseja excluir este cupom?</h3>
<div>
    <h4>Cupom</h4>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <dl class="row">
        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10 font-monospace">@Model.Codigo</dd>
        <dt class="col-sm-2">Desconto</dt>
        <dd class="col-sm-10">@Model.DescreverDesconto()</dd>
    </dl>

    <form asp-action="Exclui">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar</a>
    </form>
</div>
