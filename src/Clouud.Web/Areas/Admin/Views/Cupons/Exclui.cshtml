@model Clouud.Web.Models.Cupom

@{
    ViewData["Title"] = "Excluir cupom";
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Cupons</a> / Excluir</nav>
        <h1>Excluir cupom</h1>
    </div>
</div>
<div class="alert alert-danger alert-com-icone">
    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
    <div><strong>Tem certeza que deseja excluir este cupom?</strong> Esta ação não pode ser desfeita.</div>
</div>
<div class="painel confirmar-exclusao">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <dl class="row mb-0">
        <dt class="col-sm-3 text-muted fw-normal">Código</dt>
        <dd class="col-sm-9 font-monospace">@Model.Codigo</dd>
        <dt class="col-sm-3 text-muted fw-normal">Desconto</dt>
        <dd class="col-sm-9">@Model.DescreverDesconto()</dd>
    </dl>

    <form asp-action="Exclui" class="rodape-form">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        <input type="submit" value="Excluir" class="btn btn-danger px-4" />
    </form>
</div>
