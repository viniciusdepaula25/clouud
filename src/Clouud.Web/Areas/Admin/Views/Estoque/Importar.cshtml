@model Clouud.Web.ViewModels.ImportarChavesViewModel
@using Clouud.Web.Services

@{
    ViewData["Title"] = "Importar chaves";
    var resultado = ViewData["Resultado"] as ResultadoImportacao;
}

<h1>Importar chaves</h1>
<hr />
<partial name="_Produto" model="Model.Produto" />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Importar" asp-route-id="@Model.Produto.ProdutoId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (resultado != null)
            {
                <ul class="text-warning">
                    @if (resultado.JaCadastradas.Count > 0)
                    {
                        <li>Já cadastradas: @string.Join(", ", resultado.JaCadastradas.Take(20))@(resultado.JaCadastradas.Count > 20 ? "..." : "")</li>
                    }
                    @if (resultado.RepetidasNoTexto.Count > 0)
                    {
                        <li>Repetidas no texto: @string.Join(", ", resultado.RepetidasNoTexto.Distinct().Take(20))</li>
                    }
                    @if (resultado.Invalidas.Count > 0)
                    {
                        <li>@resultado.Invalidas.Count linha(s) com mais de @Clouud.Web.Models.Chave.TamanhoMaximoCodigo caracteres</li>
                    }
                </ul>
            }
            <div class="form-group">
                <label asp-for="Codigos" class="control-label"></label>
                <textarea asp-for="Codigos" class="form-control font-monospace" rows="14" spellcheck="false" autocomplete="off"
                          placeholder="AAAAA-BBBBB-CCCCC&#10;DDDDD-EEEEE-FFFFF"></textarea>
                <small class="form-text">
                    Cole uma chave por linha (até @EstoqueService.MaximoPorImportacao por vez). Linhas vazias são ignoradas,
                    e chaves repetidas ou já cadastradas na loja não entram de novo.
                </small>
                <div id="contador" class="small mt-1"></div>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Importar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Chaves" asp-route-id="@Model.Produto.ProdutoId">Ver chaves</a> |
    <a asp-action="Index">Voltar ao estoque</a>
</div>

@section Scripts {
    <script>
        // Mostra quantas linhas foram coladas
        (function () {
            const campo = document.getElementById("Codigos");
            const contador = document.getElementById("contador");
            const atualizar = () => {
                const linhas = campo.value.split("\n").map(l => l.trim()).filter(l => l.length > 0);
                const unicas = new Set(linhas).size;
                contador.textContent = linhas.length === 0 ? "" :
                    `${linhas.length} linha(s)` + (unicas < linhas.length ? `, ${linhas.length - unicas} repetida(s)` : "");
            };
            campo.addEventListener("input", atualizar);
            atualizar();
        })();
    </script>
}
