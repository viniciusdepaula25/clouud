@model Clouud.Web.ViewModels.ChavesProdutoViewModel
@using Clouud.Web.Models

@{
    ViewData["Title"] = "Chaves";
    var filtro = Model.Filtro;
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Estoque</a> / Chaves</nav>
        <h1>Chaves do produto</h1>
    </div>
</div>
@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success">@mensagem</div>
}
@if (TempData["Aviso"] is string aviso)
{
    <div class="alert alert-warning">@aviso</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}
<partial name="_Produto" model="Model.Produto" />

<div class="filtros-admin d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div class="btn-group flex-wrap" role="group" aria-label="Filtrar por situação">
        <a asp-action="Chaves" asp-route-id="@Model.Produto.ProdutoId"
           class="btn btn-sm @(filtro == null ? "btn-danger" : "btn-outline-secondary")">Todas</a>
        @foreach (var status in Enum.GetValues<StatusChave>())
        {
            <a asp-action="Chaves" asp-route-id="@Model.Produto.ProdutoId" asp-route-status="@status"
               class="btn btn-sm @(filtro == status ? "btn-danger" : "btn-outline-secondary")">@status.Descricao()</a>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.MostrarCodigos)
        {
            <a asp-action="Chaves" asp-route-id="@Model.Produto.ProdutoId" asp-route-status="@filtro" class="btn btn-outline-light btn-sm" id="esconderCodigos"><i class="bi bi-eye-slash" aria-hidden="true"></i>Esconder códigos</a>
        }
        else
        {
            <a asp-action="Chaves" asp-route-id="@Model.Produto.ProdutoId" asp-route-status="@filtro" asp-route-mostrar="true"
               class="btn btn-outline-light btn-sm" id="mostrarCodigos"
               title="Mostra os códigos das chaves que nunca foram vendidas. O acesso fica registrado."><i class="bi bi-eye" aria-hidden="true"></i>Mostrar códigos</a>
        }
        <a asp-action="Importar" asp-route-id="@Model.Produto.ProdutoId" class="btn btn-danger btn-sm"><i class="bi bi-plus-lg" aria-hidden="true"></i>Importar chaves</a>
    </div>
</div>

<div class="tabela-painel">
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th scope="col">Código</th>
            <th scope="col">Situação</th>
            <th scope="col">Adicionada em</th>
            <th scope="col">Pedido</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Chaves.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Nenhuma chave@(filtro == null ? "" : $" com a situação {filtro.Value.Descricao().ToLower()}").</td></tr>
        }
        @foreach (var chave in Model.Chaves)
        {
            <tr>
                <td class="font-monospace">
                    @* O código completo só vai para a página quando pedido, e nunca o de chaves que foram para um cliente *@
                    @if (Model.MostrarCodigos && chave.NuncaFoiVendida)
                    {
                        <span class="codigo-completo">@chave.Codigo</span>
                    }
                    else
                    {
                        <span class="codigo-mascarado">@chave.CodigoMascarado()</span>
                    }
                </td>
                <td><span class="situacao @(chave.Status == StatusChave.Disponivel ? "situacao-sucesso" : chave.Status == StatusChave.Vendida ? "situacao-info" : chave.Status == StatusChave.Reservada ? "situacao-aviso" : "situacao-neutra")">@chave.Status.Descricao()</span></td>
                <td>@chave.AdicionadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @if (chave.PedidoItem != null)
                    {
                        <a asp-controller="Pedidos" asp-action="Detalhes" asp-route-id="@chave.PedidoItem.PedidoId">#@chave.PedidoItem.PedidoId</a>
                    }
                </td>
                <td class="text-end text-nowrap">
                    @if (chave.Status == StatusChave.Disponivel)
                    {
                        <form asp-action="Inativar" asp-route-id="@chave.Id" asp-route-filtro="@filtro" method="post" class="d-inline">
                            <input type="submit" value="Inativar" class="btn btn-secondary btn-sm" />
                        </form>
                    }
                    else if (chave.Status == StatusChave.Inativa && chave.NuncaFoiVendida)
                    {
                        <form asp-action="Reativar" asp-route-id="@chave.Id" asp-route-filtro="@filtro" method="post" class="d-inline">
                            <input type="submit" value="Reativar" class="btn btn-secondary btn-sm" />
                        </form>
                    }
                    @if (chave.Status is StatusChave.Disponivel or StatusChave.Inativa && chave.NuncaFoiVendida)
                    {
                        <form asp-action="Excluir" asp-route-id="@chave.Id" asp-route-filtro="@filtro" method="post" class="d-inline"
                              data-confirmar="Excluir esta chave do estoque?">
                            <input type="submit" value="Excluir" class="btn btn-outline-danger btn-sm" />
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
@if (Model.Total > Model.Chaves.Count)
{
    <p class="text-muted small mt-2">Mostrando as @Model.Chaves.Count chaves mais recentes de @Model.Total. Use os filtros para ver as outras.</p>
}

<div class="mt-3 d-flex gap-2">
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i>Voltar ao estoque</a>
    <a asp-controller="Produto" asp-action="Index" asp-route-jogoId="" class="btn btn-outline-secondary">Produtos</a>
</div>
