@model IEnumerable<Clouud.Web.ViewModels.EstoqueProdutoViewModel>
@using Clouud.Web.ViewModels

@{
    ViewData["Title"] = "Estoque";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Estoque de chaves</h1>
        <p class="subtitulo">Chaves de ativação de cada produto. Produto sem chave disponível aparece como <strong>Esgotado</strong> na loja.</p>
    </div>
</div>
<form asp-action="Index" method="get" class="filtros-admin d-flex flex-wrap gap-2 align-items-center" role="search">
    <label for="txtBusca" class="visually-hidden">Buscar pelo jogo</label>
    <input type="search" id="txtBusca" name="busca" value="@ViewData["Busca"]" placeholder="Nome do jogo" class="form-control" style="max-width: 360px" />
    <input type="submit" value="Buscar" class="btn btn-secondary" />
    <span class="ms-auto small text-muted"><span class="badge bg-warning text-dark">n</span> estoque baixo (menos de @EstoqueProdutoViewModel.EstoqueBaixo) · <span class="text-danger">♥</span> clientes com o jogo na lista de desejos</span>
</form>
<div class="tabela-painel">
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th scope="col">Jogo</th>
            <th scope="col">Plataforma</th>
            <th scope="col">Edição</th>
            <th scope="col" class="text-end">Disponíveis</th>
            <th scope="col" class="text-end">Reservadas</th>
            <th scope="col" class="text-end">Vendidas</th>
            <th scope="col" class="text-end">Inativas</th>
            <th scope="col" class="text-end" title="Clientes com o jogo na lista de desejos">Desejos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center text-muted py-4">Nenhum produto encontrado. <a asp-controller="Produto" asp-action="Inclui">Cadastre um produto</a> para adicionar chaves.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td class="titulo-linha fw-semibold">
                    @item.Jogo
                    @if (!item.Ativo)
                    {
                        <span class="badge bg-secondary">fora da loja</span>
                    }
                </td>
                <td>@item.Plataforma</td>
                <td>@item.Edicao</td>
                <td class="text-end">
                    @if (item.Disponiveis == 0)
                    {
                        <span class="badge bg-danger">Esgotado</span>
                    }
                    else if (item.Disponiveis < EstoqueProdutoViewModel.EstoqueBaixo)
                    {
                        <span class="badge bg-warning text-dark">@item.Disponiveis</span>
                    }
                    else
                    {
                        @item.Disponiveis
                    }
                </td>
                <td class="text-end">@item.Reservadas</td>
                <td class="text-end">@item.Vendidas</td>
                <td class="text-end">@item.Inativas</td>
                <td class="text-end">@if (item.Desejos > 0) { <span class="text-danger">@($"♥ {item.Desejos}")</span> } else { <span class="text-muted">0</span> }</td>
                <td>
                    <div class="acoes-linha">
                        <a asp-action="Importar" asp-route-id="@item.ProdutoId" class="btn btn-secondary btn-sm text-nowrap">Importar chaves</a>
                        <a asp-action="Chaves" asp-route-id="@item.ProdutoId" class="btn btn-secondary btn-sm text-nowrap">Ver chaves</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
