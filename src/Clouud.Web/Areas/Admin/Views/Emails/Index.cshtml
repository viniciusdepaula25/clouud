@model List<Clouud.Web.Models.Email>
@using Clouud.Web.Models
@{
    ViewData["Title"] = "E-mails";
    var tipo = ViewData["Tipo"] as TipoEmail?;
    var situacao = ViewData["Situacao"] as string;
    var nomes = new Dictionary<TipoEmail, string>
    {
        [TipoEmail.BoasVindas] = "Boas-vindas",
        [TipoEmail.ConfirmarEmail] = "Confirmar e-mail",
        [TipoEmail.RedefinirSenha] = "Redefinir senha",
        [TipoEmail.SenhaAlterada] = "Senha alterada",
        [TipoEmail.PedidoPago] = "Pedido pago",
        [TipoEmail.ListaDesejos] = "Lista de desejos",
        [TipoEmail.EmailAlterado] = "E-mail alterado",
    };
    var fuso = TimeZoneInfo.Local;
}

<div class="cabecalho-pagina">
    <div>
        <h1>E-mails</h1>
        <p class="subtitulo">E-mails automáticos da loja. Eles entram numa fila e são enviados em segundo plano; se o servidor de e-mail falhar,
    a loja tenta de novo até @Email.MaximoTentativas vezes. Depois do envio o conteúdo é apagado (links de senha e chaves não ficam guardados).</p>
    </div>
</div>
<div class="d-flex flex-wrap gap-2 mb-3 small">
    <span class="situacao situacao-aviso">Na fila agora: <strong id="emailsPendentes">@ViewData["Pendentes"]</strong></span>
    <span class="situacao situacao-perigo">Falharam: <strong id="emailsFalhas">@ViewData["Falhas"]</strong></span>
</div>

<form asp-action="Index" method="get" class="filtros-admin d-flex flex-wrap gap-2 align-items-center" role="search">
    <select name="tipo" class="form-select" style="width: auto" aria-label="Tipo">
        <option value="">Todos os tipos</option>
        @foreach (var (valor, nome) in nomes)
        {
            <option value="@valor" selected="@(tipo == valor)">@nome</option>
        }
    </select>
    <select name="situacao" class="form-select" style="width: auto" aria-label="Situação">
        <option value="">Todas as situações</option>
        <option value="enviados" selected="@(situacao == "enviados")">Enviados</option>
        <option value="pendentes" selected="@(situacao == "pendentes")">Na fila</option>
        <option value="falhas" selected="@(situacao == "falhas")">Falharam</option>
    </select>
    <input type="search" name="busca" value="@ViewData["Busca"]" placeholder="Destinatário ou assunto" class="form-control" style="max-width: 320px" />
    <input type="submit" value="Filtrar" class="btn btn-secondary" />
</form>

<div class="tabela-painel">
<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead>
            <tr><th>Criado em</th><th>Tipo</th><th>Para</th><th>Assunto</th><th>Situação</th></tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">Nenhum e-mail encontrado.</td></tr>
            }
            @foreach (var email in Model)
            {
                <tr>
                    <td class="text-nowrap">@TimeZoneInfo.ConvertTimeFromUtc(email.CriadoEm, fuso).ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@nomes[email.Tipo]</td>
                    <td>@email.Para</td>
                    <td>@email.Assunto</td>
                    <td>
                        @if (email.EnviadoEm.HasValue)
                        {
                            <span class="situacao situacao-sucesso">Enviado</span>
                            <small class="text-muted">@TimeZoneInfo.ConvertTimeFromUtc(email.EnviadoEm.Value, fuso).ToString("HH:mm:ss")</small>
                        }
                        else if (email.Desistiu)
                        {
                            <span class="situacao situacao-perigo">Falhou</span>
                            <small class="d-block text-muted">@email.UltimoErro</small>
                        }
                        else
                        {
                            <span class="situacao situacao-aviso">Na fila</span>
                            @if (email.Tentativas > 0)
                            {
                                <small class="d-block text-muted">@email.Tentativas tentativa(s): @email.UltimoErro</small>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
