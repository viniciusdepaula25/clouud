@model IEnumerable<Clouud.Web.Models.Jogo>

@{
    ViewData["Title"] = "Jogos";
}

<h1>Jogos Cadastrados</h1>
<hr />
@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success">@mensagem</div>
}
<div class="d-flex justify-content-between">
    <div>
        <a class="btn btn btn-secondary" asp-action="Inclui">Cadastre um Jogo</a>
    </div>
    <div class="d-inline-flex">
        <form asp-action="Index" method="post" class="d-flex">
            <div class="form-group mb-2">
                <input type="search" id="txtBusca" name="busca" value="@ViewData["Busca"]" placeholder="Ex: Tekken 8" class="form-control me-sm-2" />
            </div>
            <input type="submit" value="Buscar" class="btn btn-secondary my-2 my-sm-0" />
        </form>
    </div>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col"></th>
            <th scope="col">@Html.DisplayNameFor(model => model.Titulo)</th>
            <th scope="col">Desenvolvedora</th>
            <th scope="col">Categorias</th>
            <th scope="col">Produtos</th>
            <th scope="col">Situação</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7">Nenhum jogo encontrado.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@(string.IsNullOrEmpty(item.Capa) ? Url.Content("~/img/sem-capa.svg") : Url.Content("~/uploads/" + item.Capa))"
                         alt="" width="48" height="64" style="object-fit: cover" onerror="this.onerror=null;this.src='@Url.Content("~/img/sem-capa.svg")'" />
                </td>
                <td>
                    @item.Titulo
                    @if (item.Destaque)
                    {
                        <span class="badge bg-warning text-dark">Destaque</span>
                    }
                </td>
                <td>@item.Desenvolvedora?.Nome</td>
                <td>@string.Join(", ", item.Categorias.OrderBy(c => c.Nome).Select(c => c.Nome))</td>
                <td>
                    @if (item.Produtos.Count == 0)
                    {
                        <span class="text-warning">Nenhum (não aparece na loja)</span>
                    }
                    else
                    {
                        @string.Join(", ", item.Produtos.Select(p => p.Plataforma.Nome).Distinct().Order())
                    }
                    <br />
                    <a asp-controller="Produto" asp-action="Index" asp-route-jogoId="@item.Id" class="small">Gerenciar produtos</a>
                </td>
                <td>@(item.Ativo ? "Ativo" : "Inativo")</td>
                <td>
                    <a asp-action="Altera" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Alterar</a> |
                    <a asp-action="Exibe" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Exibir</a> |
                    <a asp-action="Exclui" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
