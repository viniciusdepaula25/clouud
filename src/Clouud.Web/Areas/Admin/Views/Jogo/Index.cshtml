@model IEnumerable<Clouud.Web.Models.Jogo>

@{
    ViewData["Title"] = "Jogo";
}

<h1>Jogos Cadastrados</h1>
<hr />
<div class="d-flex justify-content-between">
    <div>
        <a class="btn btn btn-secondary" asp-action="Inclui">Cadastre um Jogo</a>
    </div>
    <div class="d-inline-flex">
        <form asp-action="Index" method="post" class="d-flex">
            <div class="form-group mb-2">
                <input type="search" id="txtBusca" name="busca" placeholder="Ex: Tekken 8" class="form-control me-sm-2" />
            </div>
            <input type="submit" value="Buscar" class="btn btn-secondary my-2 my-sm-0" />
        </form>
    </div>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Desenvolvedora)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Categoria)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Valorj)
            </th>
            <th scope="col">
                @Html.DisplayNameFor(model => model.Foto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td scope="col">
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
                <td scope="col">
                @Html.DisplayFor(modelItem => item.Desenvolvedora)
            </td>
                <td scope="col">
                @Html.DisplayFor(modelItem => item.Categoria)
            </td>
                <td scope="col">
                @Html.DisplayFor(modelItem => item.Valorj)
            </td>
                <td scope="col">
                @Html.DisplayFor(modelItem => item.Foto)
            </td>
                <td scope="col">
                    <a asp-action="Altera" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Alterar</a> |
                    <a asp-action="Exibe" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Exibir</a> |
                    <a asp-action="Exclui" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
