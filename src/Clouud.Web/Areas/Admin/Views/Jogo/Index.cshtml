@model IEnumerable<Clouud.Web.Models.Jogo>

@{
    ViewData["Title"] = "Jogos";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Jogos</h1>
        <p class="subtitulo">Informações de cada jogo. O jogo só aparece na loja depois de ter um produto ativo.</p>
    </div>
    <div class="acoes">
        <a class="btn btn-danger" asp-action="Inclui"><i class="bi bi-plus-lg" aria-hidden="true"></i>Cadastre um Jogo</a>
    </div>
</div>
<partial name="_Alertas" />
<form asp-action="Index" method="post" class="filtros-admin d-flex flex-wrap gap-2 align-items-center" role="search">
    <label for="txtBusca" class="visually-hidden">Buscar jogo</label>
    <input type="search" id="txtBusca" name="busca" value="@ViewData["Busca"]" placeholder="Buscar pelo título" class="form-control" style="max-width: 360px" />
    <input type="submit" value="Buscar" class="btn btn-secondary" />
    <span class="ms-auto small text-muted">@Model.Count() @(Model.Count() == 1 ? "jogo" : "jogos")</span>
</form>
<div class="tabela-painel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col"><span class="visually-hidden">Capa</span></th>
                    <th scope="col">@Html.DisplayNameFor(model => model.Titulo)</th>
                    <th scope="col">Desenvolvedora</th>
                    <th scope="col">Categorias</th>
                    <th scope="col">Produtos</th>
                    <th scope="col">Situação</th>
                    <th scope="col"><span class="visually-hidden">Ações</span></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Nenhum jogo encontrado.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@(string.IsNullOrEmpty(item.Capa) ? Url.Content("~/img/sem-capa.svg") : Url.Content("~/uploads/" + item.Capa))"
                                 alt="" class="capa-tabela" data-fallback="@Url.Content("~/img/sem-capa.svg")" />
                        </td>
                        <td>
                            <span class="titulo-linha fw-semibold">@item.Titulo</span>
                            @if (item.Destaque)
                            {
                                <span class="badge bg-warning text-dark ms-1">Destaque</span>
                            }
                        </td>
                        <td>@item.Desenvolvedora?.Nome</td>
                        <td class="small">@string.Join(", ", item.Categorias.OrderBy(c => c.Nome).Select(c => c.Nome))</td>
                        <td class="small">
                            @if (item.Produtos.Count == 0)
                            {
                                <span class="texto-aviso">Nenhum (não aparece na loja)</span>
                            }
                            else
                            {
                                @string.Join(", ", item.Produtos.Select(p => p.Plataforma.Nome).Distinct().Order())
                            }
                            <div class="mt-1 text-nowrap">
                                <a asp-controller="Produto" asp-action="Index" asp-route-jogoId="@item.Id">Gerenciar produtos</a> ·
                                <a asp-controller="Galeria" asp-action="Index" asp-route-id="@item.Id">Galeria (@item.Imagens.Count)</a>
                            </div>
                        </td>
                        <td><span class="situacao @(item.Ativo ? "situacao-sucesso" : "situacao-neutra")">@(item.Ativo ? "Ativo" : "Inativo")</span></td>
                        <td>
                            <div class="acoes-linha">
                                <a asp-action="Altera" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Alterar</a>
                                <a asp-action="Exibe" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Exibir</a>
                                <a asp-action="Exclui" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
