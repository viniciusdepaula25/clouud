@model Clouud.Web.Models.Jogo
@* Dados do jogo e seus produtos, usados em Exibe e Exclui *@
@{
    var hoje = DateOnly.FromDateTime(DateTime.Today);
}
<div class="painel mb-4">
<div class="row g-4">
    <div class="col-md-4">
        <img src="@(string.IsNullOrEmpty(Model.Capa) ? Url.Content("~/img/sem-capa.svg") : Url.Content("~/uploads/" + Model.Capa))"
             alt="Capa" class="capa-previa" data-fallback="@Url.Content("~/img/sem-capa.svg")" />
    </div>
    <div class="col-md-8">
        <dl class="row mb-0 lista-dados-bs">
            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.Titulo)</dt>
            <dd class="col-sm-9">@Model.Titulo</dd>
            <dt class="col-sm-3 text-muted fw-normal">Endereço</dt>
            <dd class="col-sm-9">@Model.Slug</dd>
            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.Descricao)</dt>
            <dd class="col-sm-9" style="white-space: pre-line">@Model.Descricao</dd>
            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.DataLancamento)</dt>
            <dd class="col-sm-9">@Model.DataLancamento?.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.ClassificacaoIndicativa)</dt>
            <dd class="col-sm-9">@(Model.ClassificacaoIndicativa == "L" ? "Livre" : Model.ClassificacaoIndicativa)</dd>
            <dt class="col-sm-3 text-muted fw-normal">Desenvolvedora</dt>
            <dd class="col-sm-9">@Model.Desenvolvedora?.Nome</dd>
            <dt class="col-sm-3 text-muted fw-normal">Publicadora</dt>
            <dd class="col-sm-9">@Model.Publicadora?.Nome</dd>
            <dt class="col-sm-3 text-muted fw-normal">Categorias</dt>
            <dd class="col-sm-9">@string.Join(", ", Model.Categorias.OrderBy(c => c.Nome).Select(c => c.Nome))</dd>
            <dt class="col-sm-3 text-muted fw-normal">Situação</dt>
            <dd class="col-sm-9">@(Model.Ativo ? "Ativo" : "Inativo")@(Model.Destaque ? ", em destaque" : "")</dd>
        </dl>
    </div>
</div>
</div>

<h2 class="titulo-secao mb-3">Produtos</h2>
<div class="tabela-painel">
<div class="table-responsive">
<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Plataforma</th>
            <th>Edição</th>
            <th>Região</th>
            <th>Preço</th>
            <th>Preço atual</th>
            <th>Situação</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Produtos.Count == 0)
        {
            <tr><td colspan="6" class="text-muted text-center py-3">Nenhum produto. O jogo só aparece na loja depois de ter um produto ativo.</td></tr>
        }
        @foreach (var produto in Model.Produtos.OrderBy(p => p.Plataforma.Nome).ThenBy(p => p.Edicao))
        {
            <tr>
                <td>@produto.Plataforma.Nome</td>
                <td>@produto.Edicao</td>
                <td>@produto.Regiao</td>
                <td>@produto.Preco.ToString("C")</td>
                <td>
                    @produto.PrecoAtual(hoje).ToString("C")
                    @if (produto.EmPromocao(hoje))
                    {
                        <span class="situacao situacao-perigo ms-1">promoção</span>
                    }
                </td>
                <td><span class="situacao @(produto.Ativo ? "situacao-sucesso" : "situacao-neutra")">@(produto.Ativo ? "À venda" : "Inativo")</span></td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
