@model Clouud.Web.ViewModels.JogoFormViewModel

@{
    ViewData["Title"] = "Altera";
}

<h1>Altera</h1>

<h4>Jogo</h4>
<hr />
<form asp-action="Altera" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />
    <div class="form-group mt-3">
        <input type="submit" value="Salvar" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-controller="Produto" asp-action="Index" asp-route-jogoId="@Model.Id">Produtos deste jogo</a> |
    <a asp-action="Index">Voltar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
