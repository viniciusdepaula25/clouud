@model Clouud.Web.Models.Jogo

@{
    ViewData["Title"] = "Excluir jogo";
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Jogos</a> / Excluir</nav>
        <h1>Excluir jogo</h1>
    </div>
</div>
<div class="alert alert-danger alert-com-icone">
    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
    <div><strong>Tem certeza que deseja excluir este jogo?</strong> Esta ação não pode ser desfeita.</div>
</div>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<partial name="_Detalhes" model="Model" />

<form asp-action="Exclui" class="form-admin confirmar-exclusao mt-3">
    <input type="hidden" asp-for="Id" />
    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        <input type="submit" value="Excluir" class="btn btn-danger px-4" />
    </div>
</form>
