@model Clouud.Web.ViewModels.JogoFormViewModel
@using Clouud.Web.Models
@* Campos do formulário de jogo, usados em Inclui e Altera *@

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-4">
    <div class="col-lg-8">
        <div class="form-group mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Descricao" class="form-label"></label>
            <textarea asp-for="Descricao" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Descricao" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="form-group col-sm-6 mb-3">
                <label asp-for="DataLancamento" class="form-label"></label>
                <input asp-for="DataLancamento" class="form-control" />
                <span asp-validation-for="DataLancamento" class="text-danger"></span>
            </div>
            <div class="form-group col-sm-6 mb-3">
                <label asp-for="ClassificacaoIndicativa" class="form-label"></label>
                <select asp-for="ClassificacaoIndicativa" class="form-select">
                    <option value="">Não informada</option>
                    @foreach (var classificacao in Jogo.Classificacoes)
                    {
                        <option value="@classificacao">@(classificacao == "L" ? "Livre" : classificacao + " anos")</option>
                    }
                </select>
            </div>
        </div>
        <div class="row">
            <div class="form-group col-sm-6 mb-3">
                <label asp-for="Desenvolvedora" class="form-label"></label>
                <input asp-for="Desenvolvedora" class="form-control" list="empresas" autocomplete="off" />
                <span asp-validation-for="Desenvolvedora" class="text-danger"></span>
            </div>
            <div class="form-group col-sm-6 mb-3">
                <label asp-for="Publicadora" class="form-label"></label>
                <input asp-for="Publicadora" class="form-control" list="empresas" autocomplete="off" />
                <span asp-validation-for="Publicadora" class="text-danger"></span>
            </div>
            <datalist id="empresas">
                @foreach (var empresa in Model.OpcoesEmpresas)
                {
                    <option value="@empresa"></option>
                }
            </datalist>
            <small class="form-text">Escolha da lista ou digite um nome novo; a empresa é cadastrada ao salvar.</small>
        </div>
        <fieldset class="form-group mt-1">
            <legend class="form-label fs-6">Categorias</legend>
            <div class="grade-opcoes">
                @foreach (var categoria in Model.OpcoesCategorias)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="CategoriaIds" value="@categoria.Id"
                               id="categoria-@categoria.Id" checked="@Model.CategoriaIds.Contains(categoria.Id)" />
                        <label class="form-check-label" for="categoria-@categoria.Id">@categoria.Nome</label>
                    </div>
                }
            </div>
            @if (Model.OpcoesCategorias.Count == 0)
            {
                <small class="form-text">Nenhuma categoria cadastrada. <a asp-controller="Categoria" asp-action="Index">Cadastrar categorias</a></small>
            }
        </fieldset>
        <div class="form-check form-switch mt-3">
            <input asp-for="Destaque" class="form-check-input" role="switch" />
            <label asp-for="Destaque" class="form-check-label"></label>
        </div>
        <div class="form-check form-switch mt-2">
            <input asp-for="Ativo" class="form-check-input" role="switch" />
            <label asp-for="Ativo" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="form-group mb-3">
            <label for="txtArquivo" class="form-label">Capa</label>
            @{
                var srcCapa = Model.CapaAtual != null ? Url.Content("~/uploads/" + Model.CapaAtual) : Url.Content("~/img/sem-capa.svg");
                var altCapa = Model.CapaAtual != null ? "Capa atual" : "Prévia da capa";
            }
            <img src="@srcCapa" alt="@altCapa"
                 id="previaCapa" class="capa-previa d-block mb-2" data-fallback="@Url.Content("~/img/sem-capa.svg")" />
            @if (Model.CapaAtual != null)
            {
                <small class="form-text d-block mb-2">Escolha um arquivo só se quiser trocar a capa.</small>
            }
            <input type="file" name="arquivo" id="txtArquivo" class="form-control" accept="@Clouud.Web.Services.ImagemUpload.AcceptHtml" />
            <small class="form-text d-block">@Clouud.Web.Services.ImagemUpload.FormatosAceitos, até @(Jogo.TamanhoMaximoCapa / (1024 * 1024)) MB.</small>
            <span class="text-danger d-block" id="erroCapa">@Html.ValidationMessage("arquivo")</span>
            <script>
                // Avisa na hora se a capa passar do tamanho máximo (o servidor confere de novo)
                document.getElementById("txtArquivo").addEventListener("change", function () {
                    const erro = document.getElementById("erroCapa");
                    erro.textContent = "";
                    if (this.files[0] && this.files[0].size > @Jogo.TamanhoMaximoCapa) {
                        erro.textContent = "Capa: a imagem pode ter no máximo @(Jogo.TamanhoMaximoCapa / (1024 * 1024)) MB.";
                        this.value = "";
                        return;
                    }
                    // prévia da capa escolhida, antes de enviar
                    if (this.files[0]) {
                        document.getElementById("previaCapa").src = URL.createObjectURL(this.files[0]);
                    }
                });
            </script>
        </div>
    </div>
</div>
