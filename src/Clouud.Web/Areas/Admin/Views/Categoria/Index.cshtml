@model IEnumerable<Clouud.Web.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Categorias</h1>
        <p class="subtitulo">Gêneros dos jogos. Um jogo pode ter várias categorias; elas aparecem como filtro na vitrine.</p>
    </div>
</div>
<partial name="_Alertas" />
<form asp-action="Inclui" method="post" class="filtros-admin d-flex flex-wrap gap-2 align-items-center">
    <label for="novaCategoria" class="form-label mb-0 me-1"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Nova categoria</label>
    <input type="text" name="nome" id="novaCategoria" maxlength="60" placeholder="Nova categoria" class="form-control" style="max-width: 320px" required />
    <input type="submit" value="Adicionar" class="btn btn-danger" />
</form>
<div class="tabela-painel">
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Jogos</th>
            <th><span class="visually-hidden">Ações</span></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="3" class="text-center text-muted py-4">Nenhuma categoria cadastrada.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <form asp-action="Altera" asp-route-id="@item.Id" method="post" class="d-flex gap-2" style="max-width: 420px">
                        <input type="text" name="nome" value="@item.Nome" maxlength="60" class="form-control form-control-sm" required
                               aria-label="Nome da categoria" />
                        <input type="submit" value="Renomear" class="btn btn-secondary btn-sm" />
                    </form>
                </td>
                <td>@item.Jogos.Count</td>
                <td class="text-end">
                    <form asp-action="Exclui" asp-route-id="@item.Id" method="post"
                          data-confirmar="Excluir a categoria @item.Nome? Os jogos continuam cadastrados.">
                        <input type="submit" value="Excluir" class="btn btn-outline-danger btn-sm" />
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
