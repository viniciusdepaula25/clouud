@model Clouud.Web.Models.Usuario

@{
    ViewData["Title"] = Model.Name;
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Usuários</a> / Exibir</nav>
        <h1>@Model.Name</h1>
    </div>
    <div class="acoes">
        <a asp-action="Altera" asp-route-id="@Model.ID" class="btn btn-primary btn-sm"><i class="bi bi-pencil" aria-hidden="true"></i>Alterar</a>
    </div>
</div>
<div class="painel">
    <partial name="_Detalhes" model="Model" />
</div>
<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i>Voltar</a>
</div>
