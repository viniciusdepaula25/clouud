@model Clouud.Web.ViewModels.UsuarioFormViewModel

@{
    ViewData["Title"] = "Cadastrar usuário";
    ViewData["NovoUsuario"] = true;
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Usuários</a> / Cadastrar</nav>
        <h1>Cadastrar usuário</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-7 col-xl-6">
        <form asp-action="Inclui" class="form-admin">
            <partial name="_Form" model="Model" view-data="ViewData" />
            <div class="rodape-form">
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                <input type="submit" value="Cadastrar" class="btn btn-primary px-4" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
