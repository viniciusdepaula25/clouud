@model IEnumerable<Clouud.Web.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
}

<h1>Usuários Cadastrados</h1>
<hr />
@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success">@mensagem</div>
}
<div class="d-flex justify-content-between">
    <div>
        <a class="btn btn btn-secondary" asp-action="Inclui">Cadastre um Usuário</a>
    </div>
    <div class="d-inline-flex">
        <form asp-action="Index" method="post" class="d-flex">
            <div class="form-group mb-2">
                <input type="search" id="txtBusca" name="busca" value="@ViewData["Busca"]" placeholder="Nome ou e-mail" class="form-control me-sm-2" />
            </div>
            <input type="submit" value="Buscar" class="btn btn-secondary my-2 my-sm-0" />
        </form>
    </div>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(model => model.Name)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Email)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Perfil)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="4">Nenhum usuário encontrado.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.Perfil)</td>
                <td>
                    <a asp-action="Altera" asp-route-id="@item.ID" class="btn btn-secondary btn-sm">Alterar</a> |
                    <a asp-action="Exibe" asp-route-id="@item.ID" class="btn btn-secondary btn-sm">Exibir</a> |
                    <a asp-action="Exclui" asp-route-id="@item.ID" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
