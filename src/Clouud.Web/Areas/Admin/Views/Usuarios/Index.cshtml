@model IEnumerable<Clouud.Web.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Usuários</h1>
    </div>
    <div class="acoes">
        <a class="btn btn-danger" asp-action="Inclui"><i class="bi bi-plus-lg" aria-hidden="true"></i>Cadastre um Usuário</a>
    </div>
</div>
<partial name="_Alertas" />
<form asp-action="Index" method="post" class="filtros-admin d-flex flex-wrap gap-2 align-items-center" role="search">
    <label for="txtBusca" class="visually-hidden">Buscar usuário</label>
    <input type="search" id="txtBusca" name="busca" value="@ViewData["Busca"]" placeholder="Nome ou e-mail" class="form-control" style="max-width: 360px" />
    <input type="submit" value="Buscar" class="btn btn-secondary" />
</form>
<div class="tabela-painel">
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th scope="col"><span class="visually-hidden">Foto</span></th>
            <th scope="col">@Html.DisplayNameFor(model => model.Name)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Email)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Perfil)</th>
            <th><span class="visually-hidden">Ações</span></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Nenhum usuário encontrado.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <img src="@Clouud.Web.Services.FotoPerfilService.Url(item.Foto)" alt="" class="rounded-circle foto-tabela"
                         data-fallback="@Clouud.Web.Services.FotoPerfilService.FotoPadrao" />
                </td>
                <td class="titulo-linha fw-semibold">@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td><span class="situacao @(item.Perfil == Clouud.Web.Models.PerfilUsuario.Admin ? "situacao-perigo" : "situacao-info")">@Html.DisplayFor(modelItem => item.Perfil)</span></td>
                <td>
                    <div class="acoes-linha">
                        <a asp-action="Altera" asp-route-id="@item.ID" class="btn btn-secondary btn-sm">Alterar</a>
                        <a asp-action="Exibe" asp-route-id="@item.ID" class="btn btn-secondary btn-sm">Exibir</a>
                        <a asp-action="Exclui" asp-route-id="@item.ID" class="btn btn-outline-danger btn-sm">Excluir</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
