@model List<Clouud.Web.Models.JogoImagem>
@using Clouud.Web.Models
@using Clouud.Web.Services

@{
    var jogo = (Jogo)ViewData["Jogo"]!;
    ViewData["Title"] = "Galeria";
    var cheia = Model.Count >= JogoImagem.MaximoPorJogo;
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-controller="Jogo" asp-action="Index">Jogos</a> / <a asp-controller="Jogo" asp-action="Altera" asp-route-id="@jogo.Id">@jogo.Titulo</a> / Galeria</nav>
        <h1>Galeria <span class="text-muted fw-normal fs-4">· @jogo.Titulo</span></h1>
        <p class="subtitulo">Telas do jogo mostradas na <a href="/jogo/@jogo.Slug" target="_blank">página do jogo</a>, na ordem abaixo. A capa continua sendo a do cadastro do jogo.</p>
    </div>
    <div class="acoes">
        <a asp-controller="Jogo" asp-action="Altera" asp-route-id="@jogo.Id" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left" aria-hidden="true"></i>Voltar ao jogo</a>
    </div>
</div>
<partial name="_Alertas" />

<form asp-action="Enviar" asp-route-id="@jogo.Id" method="post" enctype="multipart/form-data" class="form-admin mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <label for="arquivos" class="form-label mb-0"><i class="bi bi-cloud-arrow-up me-1" aria-hidden="true"></i>Adicionar imagens</label>
        <span class="small text-muted">@Model.Count de @JogoImagem.MaximoPorJogo imagens</span>
    </div>
    <div class="progress mb-3" style="height: .35rem; background: #2e2e2e" role="progressbar" aria-label="Imagens usadas" aria-valuenow="@Model.Count" aria-valuemin="0" aria-valuemax="@JogoImagem.MaximoPorJogo">
        <div class="progress-bar bg-danger" style="width: @(Model.Count * 100 / JogoImagem.MaximoPorJogo)%"></div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <input type="file" name="arquivos" id="arquivos" class="form-control flex-grow-1" style="max-width: 520px" multiple accept="@ImagemUpload.AcceptHtml" required disabled="@cheia" />
        <input type="submit" value="Enviar" class="btn btn-primary" disabled="@cheia" />
    </div>
    <small class="form-text">@ImagemUpload.FormatosAceitos, até @(JogoImagem.TamanhoMaximo / (1024 * 1024)) MB cada. Dá para escolher várias de uma vez.@(cheia ? " A galeria está cheia: exclua uma imagem para enviar outra." : "")</small>
</form>

@if (Model.Count == 0)
{
    <div class="estado-vazio">
        <i class="bi bi-images" aria-hidden="true"></i>
        <p class="titulo-vazio">Nenhuma imagem na galeria.</p>
        <p class="mb-0">Envie as telas do jogo no campo acima.</p>
    </div>
}
<div class="row g-3">
    @for (var i = 0; i < Model.Count; i++)
    {
        var imagem = Model[i];
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 imagem-galeria">
                <img src="@GaleriaService.Url(imagem)" alt="@(imagem.Legenda ?? $"Imagem {i + 1}")" class="card-img-top imagem-card-galeria" />
                <div class="card-body p-3">
                    <form asp-action="Legenda" method="post" class="d-flex gap-1 mb-2">
                        <input type="hidden" name="imagemId" value="@imagem.Id" />
                        <input type="text" name="legenda" value="@imagem.Legenda" maxlength="@JogoImagem.TamanhoLegenda" placeholder="Legenda (opcional)"
                               class="form-control form-control-sm" aria-label="Legenda da imagem @(i + 1)" />
                        <input type="submit" value="Salvar" class="btn btn-secondary btn-sm" />
                    </form>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex gap-1">
                            <form asp-action="Mover" method="post">
                                <input type="hidden" name="imagemId" value="@imagem.Id" />
                                <input type="hidden" name="direcao" value="-1" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm btn-icone" disabled="@(i == 0)" aria-label="Mover para a esquerda"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
                            </form>
                            <form asp-action="Mover" method="post">
                                <input type="hidden" name="imagemId" value="@imagem.Id" />
                                <input type="hidden" name="direcao" value="1" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm btn-icone" disabled="@(i == Model.Count - 1)" aria-label="Mover para a direita"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                            </form>
                            <span class="small text-muted align-self-center ms-1">@(i + 1)º</span>
                        </div>
                        <form asp-action="Excluir" method="post" data-confirmar="Excluir esta imagem?">
                            <input type="hidden" name="imagemId" value="@imagem.Id" />
                            <input type="submit" value="Excluir" class="btn btn-outline-danger btn-sm" />
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

