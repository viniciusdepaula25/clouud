@model ErrorViewModel
@{
    ViewData["Title"] = "Algo deu errado";
}

<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="painel-form text-center" id="paginaErro" data-codigo="500">
            <h2>Algo deu errado</h2>
            <p>Não conseguimos concluir agora. Tente de novo em instantes.</p>
            @if (Model.ShowRequestId)
            {
                @* Só o código do erro, para achar no log; nenhum detalhe técnico vai para a tela *@
                <p class="small text-muted">Código do erro: <code>@Model.RequestId</code></p>
            }
            <a href="/" class="btn btn-primary">Ir para a loja</a>
        </div>
    </div>
</div>
