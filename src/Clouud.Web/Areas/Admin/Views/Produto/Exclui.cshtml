@model Clouud.Web.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index" asp-route-jogoId="@Model.JogoId">Produtos</a> / Excluir</nav>
        <h1>Excluir produto</h1>
    </div>
</div>
<div class="alert alert-danger alert-com-icone">
    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
    <div><strong>Tem certeza que deseja excluir este produto?</strong> Esta ação não pode ser desfeita.</div>
</div>
<div class="painel confirmar-exclusao">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <dl class="row mb-0">
        <dt class="col-sm-3 text-muted fw-normal">Jogo</dt>
        <dd class="col-sm-9">@Model.Jogo.Titulo</dd>
        <dt class="col-sm-3 text-muted fw-normal">Plataforma</dt>
        <dd class="col-sm-9">@Model.Plataforma.Nome</dd>
        <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.Edicao)</dt>
        <dd class="col-sm-9">@Model.Edicao</dd>
        <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.Regiao)</dt>
        <dd class="col-sm-9">@Model.Regiao</dd>
        <dt class="col-sm-3 text-muted fw-normal">@Html.DisplayNameFor(model => model.Preco)</dt>
        <dd class="col-sm-9">@Model.Preco.ToString("C")</dd>
    </dl>

    <form asp-action="Exclui" class="rodape-form">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Index" asp-route-jogoId="@Model.JogoId" class="btn btn-secondary">Voltar</a>
        <input type="submit" value="Excluir" class="btn btn-danger px-4" />
    </form>
</div>
