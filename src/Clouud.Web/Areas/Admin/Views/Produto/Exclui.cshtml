@model Clouud.Web.Models.Produto

@{
    ViewData["Title"] = "Exclui";
}

<h1>Exclui</h1>

<h3>Tem certeza que deseja excluir este produto?</h3>
<div>
    <h4>Produto</h4>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <dl class="row">
        <dt class="col-sm-2">Jogo</dt>
        <dd class="col-sm-10">@Model.Jogo.Titulo</dd>
        <dt class="col-sm-2">Plataforma</dt>
        <dd class="col-sm-10">@Model.Plataforma.Nome</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Edicao)</dt>
        <dd class="col-sm-10">@Model.Edicao</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Regiao)</dt>
        <dd class="col-sm-10">@Model.Regiao</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Preco)</dt>
        <dd class="col-sm-10">@Model.Preco.ToString("C")</dd>
    </dl>

    <form asp-action="Exclui">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index" asp-route-jogoId="@Model.JogoId">Voltar</a>
    </form>
</div>
