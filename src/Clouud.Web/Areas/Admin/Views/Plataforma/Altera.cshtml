@model Clouud.Web.Models.Plataforma

@{
    ViewData["Title"] = "Alterar plataforma";
}

<div class="cabecalho-pagina">
    <div>
        <nav class="migalhas" aria-label="Você está em"><a asp-action="Index">Plataformas</a> / Alterar</nav>
        <h1>Alterar plataforma</h1>
    </div>
</div>
<div class="row">
    <div class="col-lg-9 col-xl-8">
        <form asp-action="Altera" class="form-admin">
            <partial name="_Form" model="Model" />
            <div class="rodape-form">
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                <input type="submit" value="Salvar" class="btn btn-primary px-4" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
