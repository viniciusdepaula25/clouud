@model IEnumerable<Clouud.Web.Models.Plataforma>

@{
    ViewData["Title"] = "Plataformas";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Plataformas</h1>
        <p class="subtitulo">Onde as chaves são ativadas. As instruções aparecem para o cliente junto da chave comprada.</p>
    </div>
    <div class="acoes">
        <a class="btn btn-danger" asp-action="Inclui"><i class="bi bi-plus-lg" aria-hidden="true"></i>Cadastre uma Plataforma</a>
    </div>
</div>
<partial name="_Alertas" />
<div class="tabela-painel">
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Produtos</th>
            <th scope="col">Situação</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="titulo-linha fw-semibold">@item.Nome</td>
                <td>@item.Produtos.Count</td>
                <td><span class="situacao @(item.Ativa ? "situacao-sucesso" : "situacao-neutra")">@(item.Ativa ? "Ativa" : "Inativa")</span></td>
                <td>
                    <div class="acoes-linha">
                        <a asp-action="Altera" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Alterar</a>
                        <a asp-action="Exclui" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Excluir</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
