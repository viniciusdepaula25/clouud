@model Clouud.Web.Models.Plataforma

@{
    ViewData["Title"] = "Exclui";
}

<h1>Exclui</h1>

<h3>Tem certeza que deseja excluir esta plataforma?</h3>
<div>
    <h4>Plataforma</h4>
    <hr />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Nome</dd>
        <dt class="col-sm-2">Produtos</dt>
        <dd class="col-sm-10">@Model.Produtos.Count</dd>
    </dl>

    <form asp-action="Exclui">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar</a>
    </form>
</div>
