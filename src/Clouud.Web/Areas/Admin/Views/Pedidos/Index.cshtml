@model IEnumerable<Clouud.Web.Models.Pedido>
@using Clouud.Web.Models

@{
    ViewData["Title"] = "Pedidos";
    var filtro = ViewData["Status"] as StatusPedido?;
    var total = (int)ViewData["Total"]!;
    var resumo = (Dictionary<StatusPedido, (int Quantidade, decimal Valor)>)ViewData["Resumo"]!;
}

<h1>Pedidos</h1>
<hr />
<div class="row g-3 mb-3">
    @foreach (var status in Enum.GetValues<StatusPedido>())
    {
        var (quantidade, valor) = resumo.GetValueOrDefault(status);
        <div class="col-6 col-md-3">
            <a asp-action="Index" asp-route-status="@status" class="text-decoration-none d-block h-100" style="margin-left: 0">
                <div class="card h-100 @(filtro == status ? "border-primary" : "")">
                    <div class="card-body py-2">
                        <div class="small text-muted">@status.Descricao()</div>
                        <div class="fs-4">@quantidade</div>
                        <div class="small">@valor.ToString("C")</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <div>
        @if (filtro.HasValue)
        {
            <span>Mostrando: <strong>@filtro.Value.Descricao()</strong></span>
            <a asp-action="Index" class="ms-2">ver todos</a>
        }
    </div>
    <form asp-action="Index" method="get" class="d-flex">
        @if (filtro.HasValue)
        {
            <input type="hidden" name="status" value="@filtro" />
        }
        <input type="search" id="txtBusca" name="busca" value="@ViewData["Busca"]" placeholder="Nº do pedido, nome ou e-mail"
               class="form-control me-sm-2" />
        <input type="submit" value="Buscar" class="btn btn-secondary" />
    </form>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Pedido</th>
            <th>Data</th>
            <th>Cliente</th>
            <th>Jogos</th>
            <th class="text-end">Total</th>
            <th>Situação</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7">Nenhum pedido encontrado.</td></tr>
        }
        @foreach (var pedido in Model)
        {
            <tr>
                <td>#@pedido.Id</td>
                <td>@pedido.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td>@pedido.Usuario.Name<br /><small class="text-muted">@pedido.Usuario.Email</small></td>
                <td>@string.Join(", ", pedido.Itens.Select(i => i.Produto.Jogo.Titulo).Distinct())</td>
                <td class="text-end">@pedido.Total.ToString("C")</td>
                <td><span class="badge @pedido.Status.Cor()">@pedido.Status.Descricao()</span></td>
                <td><a asp-action="Detalhes" asp-route-id="@pedido.Id" class="btn btn-secondary btn-sm">Detalhes</a></td>
            </tr>
        }
    </tbody>
</table>
@if (total > Model.Count())
{
    <p class="text-muted">Mostrando os @Model.Count() pedidos mais recentes de @total. Use os filtros para achar os outros.</p>
}
