# Copie para ".env" (que não vai para o Git) e troque os valores antes de usar fora do seu computador.
# O docker compose lê este arquivo sozinho.

# Senha do PostgreSQL do Docker (usada pelo banco e pela aplicação)
BANCO_SENHA=troque-esta-senha

# Senha do primeiro administrador (admin@clouud.com), criado só se ainda não existir nenhum admin
ADMIN_SENHA=troque-esta-senha-tambem
